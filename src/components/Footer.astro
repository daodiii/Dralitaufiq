---
import profile from '../data/profile.json';
import calligraphy from '../assets/hero/calligraphy-name.png';

interface Props {
  page?: 'home' | 'inner';
}

const { page = 'home' } = Astro.props;
const home = page === 'home';
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand" data-reveal>
        <p class="footer__name">Prof. Dr. Ali Mohamed Salah</p>
        <div class="footer__calli" role="img" aria-label={profile.nameArabic} style={`--calli: url(${calligraphy.src})`}></div>
      </div>

      <div class="footer__col" data-reveal data-delay="0.08">
        <p class="footer__h">Contact</p>
        <p class="footer__text">For lectures, talks and events, send a message or write through the official Facebook page.</p>
        <div class="footer__reach">
          <a class="link" href="/contact">
            Send a message
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" />
            </svg>
          </a>
          <a class="link" href={profile.social[0].url} target="_blank" rel="noopener">
            {profile.social[0].label}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M4 12L12 4M6 4h6v6" />
            </svg>
          </a>
        </div>
      </div>

      <div class="footer__col" data-reveal data-delay="0.16">
        <p class="footer__h">Navigate</p>
        <ul class="footer__links">
          <li><a href="/books">Books</a></li>
          <li><a href="/lectures">Lectures</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href={home ? '#top' : '/'}>{home ? 'Top' : 'Home'}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} Prof. Dr. Ali Mohamed Salah · Oslo</span>
      <span>
        <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · {profile.languages.join(' · ')}
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6.5rem) 2rem;
  }

  /* A gold rule across the top, brightest in the middle, gone at the edges. */
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-line) 30%, var(--gold-hi) 50%, var(--gold-line) 70%, transparent);
    opacity: 0.85;
  }

  /* The footer is black on every page (the site's three colours: white, black, gold): light words,
     gold for the accent. */
  .footer {
    --ink: #f6efe2;
    --ink-2: #efe7d8;
    --ink-3: #a9a192;
    --paper: #0c0b09;
    --accent: #d9b45a;
    --line: rgb(246 239 226 / 0.12);
    --line-strong: rgb(246 239 226 / 0.28);
    --link-ink: var(--ink);
    color: var(--ink);
    background: var(--paper);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 0.7fr;
    gap: 3rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  /* His name in the gilded calligraphy of the hero, with its slow glint. */
  .footer__calli {
    width: min(100%, 15rem);
    aspect-ratio: 885 / 310;
    margin-top: 1.1rem;
    background-image: linear-gradient(112deg, oklch(70% 0.13 80) 0%, oklch(95% 0.1 95) 42%, oklch(78% 0.14 84) 58%, oklch(97% 0.08 97) 78%, oklch(68% 0.13 78) 100%);
    background-size: 220% 100%;
    -webkit-mask: var(--calli) left center / contain no-repeat;
    mask: var(--calli) left center / contain no-repeat;
    animation: footer-glint 7s ease-in-out infinite alternate;
  }

  @keyframes footer-glint {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__calli { animation: none; }
  }

  .footer__h {
    margin-bottom: 1.1rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--gold-line);
  }

  .footer__text {
    max-width: 22rem;
    margin-bottom: 1.1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .footer__reach {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }

  .footer__links {
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .footer__links a {
    color: var(--ink-2);
    transition: color 0.4s;
  }

  .footer__links a:hover,
  .footer__links a:focus-visible {
    color: var(--gold-hi);
  }

  .footer__bottom a {
    transition: color 0.3s;
  }

  .footer__bottom a:hover {
    color: var(--gold-hi);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid rgb(217 180 90 / 0.22);
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
