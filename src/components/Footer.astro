---
import profile from '../data/profile.json';
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand" data-reveal>
        <p class="footer__name">Ali Mohamed Salah</p>
        <p class="footer__ar" lang="ar">{profile.nameArabic}</p>
      </div>

      <div class="footer__col" data-reveal data-delay="0.08">
        <p class="footer__h">Contact</p>
        <p class="footer__text">For lectures, talks and events, write through the official Facebook page.</p>
        <a class="link" href={profile.social[0].url} target="_blank" rel="noopener">
          {profile.social[0].label}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M4 12L12 4M6 4h6v6" />
          </svg>
        </a>
      </div>

      <div class="footer__col" data-reveal data-delay="0.16">
        <p class="footer__h">Navigate</p>
        <ul class="footer__links">
          <li><a href="#books">Books</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#top">Top</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} Prof. Dr. Ali Mohamed Salah · Oslo</span>
      <span>{profile.languages.join(' · ')}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    border-top: 1px solid var(--line);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 0.7fr;
    gap: 3rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .footer__ar {
    margin-top: 0.7rem;
    font-size: 1.25rem;
    color: var(--ink-3);
    text-align: left;
  }

  .footer__h {
    margin-bottom: 1rem;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .footer__text {
    max-width: 22rem;
    margin-bottom: 1.1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .footer__links {
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .footer__links a {
    color: var(--ink-2);
    transition: color 0.4s;
  }

  .footer__links a:hover {
    color: var(--accent);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
