---
/* The books page on a tablet or a computer: every book standing on one shelf, spine out, as big as
   the screen allows. Heights keep the books' true proportions; their thickness is widened by one
   shared factor so the shelf fills the width and the titles read (scripts/books/shelf.ts). All
   eighteen show at once and nothing scrolls sideways. Pointing at a spine lifts it and writes its
   title the right way up under the shelf; a click tips it out and opens its sheet. Phones get the pile instead (Pile.astro). */
import type { Book } from '../../lib/books';
import { LANGS, spineInfo } from '../../lib/spines';
import Spine from './Spine.astro';

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const infos = await Promise.all(books.map(spineInfo));
const groups = LANGS.map((L) => ({ ...L, spines: infos.filter((s) => s.lang === L.k) }));
---

<section class="shelf" aria-label="The books">
  <div class="shelf__room container">
    <div class="shelf__case">
      <div class="shelf__books">
        {
          groups.map((g) => (
            <div class="shelf__grp" role="group" aria-label={g.name}>
              <span class:list={['shelf__gl', g.k === 'ar' && 'is-ar']} lang={g.k} aria-hidden="true">
                {g.name}
              </span>
              {g.spines.map((s) => (
                <Spine s={s} max={22} />
              ))}
            </div>
          ))
        }
      </div>
      <div class="shelf__board" aria-hidden="true"></div>
      <p class="shelf__name" aria-hidden="true"></p>
    </div>
  </div>
</section>

<style>
  .shelf {
    padding-bottom: clamp(5.5rem, 10vh, 7rem);
  }

  :global(html.books-pile) .shelf {
    display: none;
  }

  .shelf__room {
    display: flex;
    justify-content: center;
    padding-top: clamp(4rem, 9vh, 6rem);
  }

  .shelf__case {
    position: relative;
  }

  .shelf__books {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: var(--ggap, 3rem);
  }

  .shelf__grp {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1px;
  }

  .shelf__gl {
    position: absolute;
    left: 0;
    bottom: calc(24.41 * var(--s, 24) * 1px + 1.2rem);
    font-size: 0.85rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .shelf__gl.is-ar {
    font-family: var(--font-arabic);
    font-size: 1.1rem;
  }

  .shelf__board {
    position: absolute;
    left: -2rem;
    right: -2rem;
    bottom: -14px;
    height: 14px;
    border-top: 1px solid var(--line-strong);
    background: linear-gradient(var(--paper-3), var(--paper));
    box-shadow: 0 18px 30px -16px rgb(40 30 20 / 0.25);
  }

  /* The title under the pointer, the right way up (scripts/books/spine-name.ts). */
  .shelf__name {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 2.2rem);
    margin: 0;
    text-align: center;
    font-size: 1.3rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.18s;
    pointer-events: none;
  }

  .shelf__name.is-ar {
    font-family: var(--font-arabic);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .shelf__name.is-on {
    opacity: 1;
  }

  /* Thickness widened by --k; heights stay true. */
  .shelf__case :global(.spine) {
    width: calc(var(--t) * var(--s, 24) * var(--k, 1) * 1px);
  }

  .shelf__case :global(.spine .spine__title) {
    font-size: min(clamp(9px, calc(var(--t) * var(--s, 24) * var(--k, 1) * 0.4px), var(--fmax)), calc(var(--h) * var(--s, 24) * 1.3px / var(--len)));
  }

  .shelf__case :global(.spine:hover),
  .shelf__case :global(.spine:focus-visible) {
    transform: translateY(-28px);
    box-shadow:
      inset 2px 0 3px rgb(0 0 0 / 0.22),
      inset -2px 0 3px rgb(0 0 0 / 0.28),
      0 24px 30px -12px rgb(30 20 10 / 0.45);
  }

  .shelf__case :global(.spine.is-out) {
    transform: translateY(-34px) translateX(8px) rotate(4deg);
    transform-origin: 100% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf__case :global(.spine) {
      transition: none;
    }
  }
</style>
