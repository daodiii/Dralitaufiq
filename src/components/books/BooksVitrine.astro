---
/**
 * The books page on a tablet or a computer, "the vitrine at night" (picked as C, 2026-11-23). On
 * black: the twenty books stand on a lit shelf with their titles on the spines, each spine a link
 * down to its book; then every book stands as an object in its own pool of light (BookStand.astro),
 * its title and "Read the whole description" leading to the book's own page (pages/books/[id]).
 * An Arabic book stands on the right and reads right to left. Styles: styles/vitrine.css.
 * ?book=<id> lands on that book (books.astro). Phones get the pile instead.
 */
import '../../styles/vitrine.css';
import type { Book } from '../../lib/books';
import { vitrine } from '../../lib/vitrine';
import BookStand from './BookStand.astro';

interface Props {
  books: Book[];
}

const { groups, view, v } = await vitrine(Astro.props.books);
const prophet = (s: string) => s.split('ﷺ');
---

<section class="vt" aria-labelledby="vt-title">
  <div class="vt__in">
    <div class="vt__head">
      <h1 id="vt-title">The library</h1>
      <p>Written into twenty books in English, Arabic and Somali, on faith, the family and Islamic law in the West.</p>
    </div>
    <div class="vt__shelf">
      {
        groups.map((g) => (
          <div class="vt__row" role="group" aria-label={g.name} dir={g.k === 'ar' ? 'rtl' : undefined}>
            {g.books.map((b) => {
              const x = v(b.id);
              return (
                <a class="vt__sp" href={`#bk-${b.id}`} style={`height:${x.h}px;width:${x.w}px;background:${x.colour};color:${x.ink}`}>
                  <span class:list={[x.rtl && 'is-ar']} lang={b.data.language}>
                    {prophet(b.data.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}
                  </span>
                </a>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>

  {view.map((x) => <BookStand x={x} />)}
</section>

