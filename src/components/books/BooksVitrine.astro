---
/**
 * The books page on a tablet or a computer, "the vitrine at night" (picked as C, 2026-11-23). On
 * black: the twenty books stand on a lit shelf with their titles on the spines, each spine a link
 * down to its book; then every book stands as an object in its own pool of light, turned a little
 * towards the reader, beside its title, the opening of its description, its colophon and its
 * Amazon listings. An Arabic book stands on the right and reads right to left.
 *
 * Sizes follow the books: a spine is as tall and as thick as the book (lib/spines.ts), its pool of
 * light is its cover's colour, warmed. The whole description opens in the side sheet
 * (BookSheet.astro). ?book=<id> lands on that book (books.astro). Phones get the pile instead.
 */
import { Image } from 'astro:assets';
import type { Book } from '../../lib/books';
import { languageName } from '../../lib/books';
import { paragraphs } from '../../lib/library';
import { spineInfo } from '../../lib/spines';

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const infos = await Promise.all(books.map(spineInfo));
const info = (id: string) => infos.find((s) => s.id === id)!;
const groups = (['en', 'ar', 'so'] as const).map((k) => ({ k, name: languageName[k], books: books.filter((b) => b.data.language === k) }));
const order = groups.flatMap((g) => g.books);

/* Colour arithmetic on the spine colours ("rgb(r g b)"). */
const rgbOf = (c: string) => c.match(/\d+/g)!.slice(0, 3).map(Number);
const lin = (v: number) => ((v /= 255) <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
const lum = (c: number[]) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
const ratio = (a: number[], b: number[]) => {
  const x = lum(a), y = lum(b);
  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
};
const INK = [22, 18, 12], PAPER = [250, 246, 237];
const inkOn = (c: string) => (ratio(rgbOf(c), INK) >= ratio(rgbOf(c), PAPER) ? 'rgb(22 18 12)' : 'rgb(250 246 237)');
const warm = (c: string) => `rgb(${rgbOf(c).map((v, i) => Math.round(v * 0.65 + [255, 236, 200][i] * 0.35)).join(' ')})`;

const prophet = (s: string) => s.split('ﷺ');
const view = order.map((b, i) => {
  const d = b.data;
  const s = info(b.id);
  const rtl = d.language === 'ar';
  const all = paragraphs(b);
  const own = rtl ? all.filter((p) => p.dir === 'rtl') : all.filter((p) => p.dir === 'ltr');
  const pool = own.length ? own : all;
  const long = pool.filter((p) => p.text.length > 70);
  const w = 9 + s.t * 6.5; /* the reading room's spine thickness, px */
  return {
    b,
    i,
    rtl,
    colour: s.colour,
    ink: inkOn(s.colour),
    glow: warm(s.colour),
    h: Math.round(s.h * 4.6 * 2.35),
    w: Math.round(Math.max(w * 2.35 * 0.72, rtl ? 48 : 40)),
    depth: Math.round(Math.max(44, w * 2.9)),
    desc: (long.length ? long : pool)[0],
    sub: d.subtitle,
    en: d.language !== 'en' && d.titleEn && d.titleEn !== d.subtitle ? d.titleEn : null,
    role: d.role !== 'Author' ? d.role : null,
    colo: [d.publisher, d.year, `${d.pages} pages`].filter(Boolean).join(' · ') + (d.badge ? '. New in 2026' : ''),
  };
});
const v = (id: string) => view.find((x) => x.b.id === id)!;
---

<section class="vt" aria-labelledby="vt-title">
  <div class="vt__in">
    <div class="vt__head">
      <h1 id="vt-title">The library</h1>
      <p>Written into twenty books in English, Arabic and Somali, on faith, the family and Islamic law in the West.</p>
    </div>
    <div class="vt__shelf">
      {
        groups.map((g) => (
          <div class="vt__row" role="group" aria-label={g.name} dir={g.k === 'ar' ? 'rtl' : undefined}>
            {g.books.map((b) => {
              const x = v(b.id);
              return (
                <a class="vt__sp" href={`#bk-${b.id}`} style={`height:${x.h}px;width:${x.w}px;background:${x.colour};color:${x.ink}`}>
                  <span class:list={[x.rtl && 'is-ar']} lang={b.data.language}>
                    {prophet(b.data.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}
                  </span>
                </a>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>

  {
    view.map((x) => (
      <article
        class="vt__bk"
        id={`bk-${x.b.id}`}
        dir={x.rtl ? 'rtl' : undefined}
        lang={x.b.data.language}
        style={`--bg:${x.colour};--sink:${x.ink};--glow:${x.glow};--d:${x.depth}px`}
      >
        <div class="vt__stage" dir="ltr">
          <div class="vt__book">
            <div class="vt__spine" aria-hidden="true">
              <span class:list={[x.rtl && 'is-ar']}>{prophet(x.b.data.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}</span>
            </div>
            <div class="vt__front">
              <Image
                src={x.b.data.cover}
                alt={`The cover of ${x.b.data.title}`}
                widths={[400, 640, 960]}
                sizes="(max-width: 1180px) 36vw, 420px"
                loading={x.i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <i />
            </div>
          </div>
          <span class="vt__floor" aria-hidden="true" />
        </div>
        <div class="vt__txt">
          <h2>{prophet(x.b.data.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}</h2>
          {x.sub && <p class="vt__sub" dir={/[؀-ۿ]/.test(x.sub) ? 'rtl' : 'ltr'}>{x.sub}</p>}
          {x.en && <p class="vt__en" lang="en" dir="ltr">{x.en}</p>}
          {x.role && <p class="vt__en" lang="en" dir="ltr">{x.role}</p>}
          <p class="vt__desc" lang={x.desc.lang} dir={x.desc.dir}>{x.desc.lead && <b>{x.desc.lead}: </b>}{x.desc.text}</p>
          <button class="vt__whole" type="button" data-open={x.b.id}>{x.rtl ? 'الوصف كاملًا' : 'Read the whole description'}</button>
          <p class="vt__colo" lang="en" dir="ltr">{x.colo}</p>
          <div class="vt__pills" dir="ltr">
            {x.b.data.amazon.map((a, i) => (
              <a class:list={['vt__pill', i > 0 && 'is-ghost']} href={a.url} target="_blank" rel="noopener">
                {i === 0 ? `Buy on Amazon · ${a.label}` : a.label}
              </a>
            ))}
          </div>
        </div>
      </article>
    ))
  }
</section>

<style is:global>
  html.books-night { background: #0c0b09; }
  /* The page's heading on a phone; on a computer the vitrine's own "The library" is the h1. */
  html:not(.books-pile) .books-pile-h1 { display: none; }
  .vt { display: none; }
  html:not(.books-pile) .vt { display: block; }

  .vt {
    --bh: clamp(360px, min(calc(100vh - 300px), 50vw), 640px);
    color: #efe7d8;
    background: #0c0b09;
  }
  .vt__in {
    max-width: var(--max);
    margin: 0 auto;
    padding: calc(var(--nav-h) + 2.2rem) var(--gutter) 3rem;
    background: radial-gradient(48% 70% at 50% 72%, rgb(255 226 170 / 0.17), transparent 70%);
  }
  .vt__head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 2.5rem; }
  .vt__head h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 2.3vw, 2.3rem); letter-spacing: -0.035em; line-height: 1.1; color: #f6efe2; }
  .vt__head p { max-width: 34rem; font-size: 1.08rem; line-height: 1.5; color: #a9a192; }

  /* The shelf: three rows, one per language, side by side while they fit, one under another after. */
  .vt__shelf { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center; gap: 2.5rem clamp(1.6rem, 3vw, 3.2rem); margin-top: 2.6rem; }
  .vt__row { display: flex; align-items: flex-end; gap: 3px; padding: 0 6px; border-bottom: 12px solid #5b4428; }
  .vt__sp {
    display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 10px 0; overflow: hidden;
    border-radius: 2px 2px 0 0; box-shadow: inset -4px 0 0 rgb(0 0 0 / 0.13), inset 3px 0 0 rgb(255 255 255 / 0.13);
    transition: transform 0.35s var(--ease-out);
  }
  .vt__sp:hover, .vt__sp:focus-visible { transform: translateY(-6px); }
  .vt__sp:focus-visible { outline: 2px solid #d9b45a; outline-offset: 3px; }
  .vt__sp span { writing-mode: vertical-rl; max-height: 100%; font-size: 13px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.08; text-align: center; }
  .vt__sp span.is-ar, .vt__spine span.is-ar { font-family: var(--font-arabic); text-transform: none; letter-spacing: 0; font-size: 16px; font-weight: 700; line-height: 1.15; }
  /* Sideways as one line, so punctuation (the ’ in Qur’an) turns with the letters instead of standing up. */
  .vt__sp span, .vt__spine span { text-orientation: sideways; }
  .vt bdi { font-family: var(--font-arabic); font-weight: 400; }

  /* Each book in its own pool of light. */
  .vt__bk {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 4rem);
    min-height: calc(var(--bh) + 260px); box-sizing: border-box; padding: max(4rem, calc(var(--nav-h) + 1rem)) max(var(--gutter), calc((100vw - 1320px) / 2)) 4rem;
    background: radial-gradient(30% 50% at 27% 44%, color-mix(in srgb, var(--glow) 42%, transparent), transparent 72%), #0c0b09;
    scroll-margin-top: 0;
  }
  .vt__bk[dir='rtl'] { background: radial-gradient(34% 46% at 70% 46%, color-mix(in srgb, var(--glow) 34%, transparent), transparent 72%), radial-gradient(60% 18% at 70% 84%, rgb(255 230 190 / 0.07), transparent 70%), #0c0b09; }
  .vt__bk::before { content: ''; position: absolute; left: 0; right: 0; top: calc(50% + var(--bh) * 0.47); height: 130px; background: linear-gradient(180deg, rgb(255 236 205 / 0.07), transparent); pointer-events: none; }

  .vt__stage { --ry: 20deg; position: relative; height: calc(var(--bh) + 120px); display: flex; align-items: center; justify-content: center; }
  .vt__book { position: relative; height: var(--bh); perspective: 1700px; perspective-origin: 30% 45%; }
  .vt__front { position: relative; height: var(--bh); transform-origin: left center; transform: rotateY(var(--ry)); transition: transform 1.4s var(--ease-out); }
  .vt__front img { height: var(--bh); width: auto; max-width: none; display: block; border-radius: 1px 4px 4px 1px; }
  .vt__front i { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(255 255 255 / 0.1), transparent 30%, rgb(0 0 0 / 0.28)); pointer-events: none; }
  .vt__spine {
    position: absolute; right: 100%; top: 0; height: var(--bh); width: var(--d); display: flex; align-items: center; justify-content: center;
    background: var(--bg); color: var(--sink); transform-origin: right center; transform: rotateY(calc(var(--ry) - 90deg));
    box-shadow: inset 0 0 0 999px rgb(0 0 0 / 0.32); transition: transform 1.4s var(--ease-out);
  }
  .vt__spine span { writing-mode: vertical-rl; max-height: 88%; overflow: hidden; font-size: 15px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .vt__spine span.is-ar { font-size: 19px; }
  .vt__floor { position: absolute; left: 50%; bottom: 40px; width: calc(var(--bh) * 0.875); height: 60px; transform: translateX(-50%); z-index: -1; background: radial-gradient(50% 50% at 50% 50%, rgb(0 0 0 / 0.75), transparent 70%); }
  /* An Arabic book opens the other way: its spine on the right. */
  .vt__bk[dir='rtl'] .vt__book { perspective-origin: 70% 45%; }
  .vt__bk[dir='rtl'] .vt__front { transform-origin: right center; transform: rotateY(calc(-1 * var(--ry))); }
  .vt__bk[dir='rtl'] .vt__front i { background: linear-gradient(270deg, rgb(255 255 255 / 0.1), transparent 30%, rgb(0 0 0 / 0.28)); }
  .vt__bk[dir='rtl'] .vt__spine { right: auto; left: 100%; transform-origin: left center; transform: rotateY(calc(90deg - var(--ry))); }

  /* A book still below the reader is turned away (.is-low, set by books.astro before the first paint)
     and turns to face them as it comes up (scripts/books/vitrine.ts removes it, once). Every book
     stands at rest by default: without scripts, with reduced motion, and whatever is in view. */
  .vt__bk.is-low .vt__stage { --ry: 66deg; }
  .vt__bk.is-low .vt__spine { box-shadow: inset 0 0 0 999px rgb(0 0 0 / 0.12); }
  .vt__bk.is-low .vt__txt { opacity: 0.25; transform: translateY(40px); }
  .vt__txt { transition: opacity 1.1s var(--ease-out), transform 1.1s var(--ease-out); }
  html.vt-wait .vt { visibility: hidden; }

  .vt__txt h2 { margin: 0 0 0.7rem; font-family: var(--font-display); font-weight: 500; font-size: clamp(2.4rem, 3.9vw, 4.2rem); line-height: 1; letter-spacing: -0.045em; color: #f6efe2; text-wrap: balance; }
  .vt__bk[dir='rtl'] h2 { font-family: var(--font-arabic); font-weight: 700; letter-spacing: 0; line-height: 1.35; }
  .vt__sub { margin-bottom: 0.5rem; font-size: 1.15rem; line-height: 1.45; color: #f6efe2; }
  .vt__en { margin-bottom: 0.4rem; font-size: 1rem; line-height: 1.45; color: #a9a192; }
  .vt__desc { max-width: 36rem; margin-top: 1.1rem; font-size: 1.06rem; line-height: 1.62; color: #c9c0b0; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .vt__desc b { font-weight: 600; color: #f6efe2; }
  .vt__bk[dir='rtl'] .vt__sub[dir='rtl'], .vt__desc[dir='rtl'] { font-family: var(--font-arabic); font-size: 1.3rem; line-height: 1.75; }
  .vt__bk[dir='rtl'] .vt__en, .vt__bk[dir='rtl'] .vt__colo { text-align: right; }
  /* An Arabic book's English lines keep the site's own letters, not the Arabic book face. */
  .vt__bk[dir='rtl'] .vt__en, .vt__bk[dir='rtl'] .vt__colo, .vt__bk[dir='rtl'] .vt__pills, .vt__bk[dir='rtl'] .vt__sub[dir='ltr'], .vt__bk[dir='rtl'] .vt__desc[dir='ltr'] { font-family: var(--font-body); }
  .vt__whole { margin-top: 0.6rem; padding: 0; border: 0; background: none; font: inherit; font-size: 0.94rem; color: #efe7d8; border-bottom: 1px solid rgb(217 180 90 / 0.7); cursor: pointer; }
  .vt__bk[dir='rtl'] .vt__whole { font-family: var(--font-arabic); font-size: 1.1rem; }
  .vt__whole:focus-visible, .vt__pill:focus-visible { outline: 2px solid #d9b45a; outline-offset: 3px; }
  .vt__colo { margin: 1.3rem 0 1rem; font-size: 0.92rem; color: #a9a192; }
  .vt__pills { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .vt__bk[dir='rtl'] .vt__pills { justify-content: flex-end; }
  .vt__pill { display: inline-flex; align-items: center; height: 3.1rem; padding: 0 1.5rem; border-radius: 999px; font-size: 1rem; font-weight: 500; white-space: nowrap; background: #d9b45a; color: #17120a; transition: background 0.3s var(--ease-out); }
  .vt__pill:hover { background: #e6c46e; }
  .vt__pill.is-ghost { background: transparent; color: #efe7d8; box-shadow: inset 0 0 0 1.5px rgb(239 231 216 / 0.55); }
  .vt__pill.is-ghost:hover { background: rgb(239 231 216 / 0.08); }

  @media (max-width: 1180px) {
    .vt__bk { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .vt__pill { height: 2.75rem; padding: 0 1.1rem; font-size: 0.94rem; }
  }
</style>
