---
/* One spine, sized from the book's real cm at --s px per cm (set by whoever holds the shelf). A
   button on the books page, which opens the sheet; a link on the home page. */
import type { SpineInfo } from '../../lib/spines';
interface Props {
  s: SpineInfo;
  max?: number;
  tag?: 'button' | 'a';
  href?: string;
}
const { s, max = 15, tag = 'button', href } = Astro.props;
const Tag = tag;
---

<Tag
  class="spine"
  type={tag === 'button' ? 'button' : undefined}
  href={href}
  data-open={s.id}
  data-order={s.order}
  data-lang={s.lang}
  aria-label={s.title}
  style={`--t:${s.t};--h:${s.h};--len:${[...s.short].length};--fmax:${max}px;background:${s.colour};color:${s.ink}`}
>
  <span class="spine__rule"></span>
  <span class:list={['spine__title', s.lang === 'ar' && 'is-ar']} lang={s.lang}>{s.short}</span>
  {s.t > 1.3 && <span class="spine__author">SALAH</span>}
  <span class="spine__rule spine__rule--b"></span>
</Tag>

<style>
  .spine {
    position: relative;
    flex: none;
    /* The true thickness (widened by the holder's --k), and never thinner than the title needs at
       the shelf's standard size (--wmin, scripts/books/spine-fit.ts). */
    width: max(calc(var(--t) * var(--s, 24) * var(--k, 1) * 1px), var(--wmin, 0px));
    height: calc(var(--h) * var(--s, 24) * 1px);
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 0;
    padding: 0;
    border-radius: 2px 2px 1px 1px;
    cursor: pointer;
    overflow: hidden;
    box-shadow:
      inset 2px 0 3px rgb(0 0 0 / 0.22),
      inset -2px 0 3px rgb(0 0 0 / 0.28),
      inset 0 0 0 0.5px rgb(0 0 0 / 0.25);
    transform-origin: 50% 100%;
    transition:
      transform 0.35s var(--ease-out-quint),
      box-shadow 0.35s var(--ease-out-quint);
  }
  .spine::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.18), transparent 22%, rgb(255 255 255 / 0.1) 48%, transparent 75%, rgb(0 0 0 / 0.22));
  }
  .spine__title {
    writing-mode: vertical-rl;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* One standard size on the whole shelf (--f); before the script, as the thickness allows. */
    font-size: var(--f, min(clamp(8px, calc(var(--t) * var(--s, 24) * 0.42px), var(--fmax)), calc(var(--h) * var(--s, 24) * 1.3px / var(--len))));
    font-weight: 520;
    letter-spacing: 0.02em;
    text-align: center;
    overflow: hidden;
    padding: 10px 0;
    line-height: 1.18;
  }
  .spine__title.is-ar {
    font-family: var(--font-arabic);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.75;
  }
  .spine__author {
    writing-mode: vertical-rl;
    font-size: clamp(6px, calc(var(--s, 24) * 0.38px), 9px);
    letter-spacing: 0.18em;
    opacity: 0.7;
    padding-bottom: 14px;
    font-weight: 500;
  }
  .spine__rule {
    width: 70%;
    height: 4px;
    margin-top: 14px;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.45;
    flex: none;
  }
  .spine__rule--b {
    margin: 0 0 12px;
  }
  .spine:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
