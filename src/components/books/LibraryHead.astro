---
/* The books page's opening: a headline and one line on what the works are about. */
---

<header class="libhead">
  <h1 class="display display--lg libhead__title" data-split>The library</h1>
  <p class="libhead__lede" data-reveal data-delay="0.2">
    Jurisprudence for Muslims in the West, dialogue between the Abrahamic faiths, the family and the unseen, in
    Arabic, English and Somali.
  </p>
</header>

<style>
  .libhead {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vh, 4rem));
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .libhead__lede {
    max-width: 25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .libhead {
      grid-template-columns: 1fr;
    }
  }

  /* A phone opens on the pile, which names the library itself; the headline stays here, unseen,
     for screen readers. */
  :global(html.js.books-pile) .libhead {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
