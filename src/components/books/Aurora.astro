---
/**
 * "Northern lights". Night over a frozen lake in Norway (nordlys, "north light"). The page
 * opens inside a ring of the 18 books standing on the ice, a curtain of aurora in its colours
 * above each, the library's name in the sky; the view turns along the ring with the mouse, or a
 * drag. Scrolling then goes book by book, left to right, English, then Arabic, then Somali, each
 * language titled in the sky in its own words, its curtains lit together; the chosen book comes
 * close into the middle of the screen as its curtain surges. A tap, a swipe or the arrow keys go
 * to a book as well, and the languages' row to each language's first book. The scene lives in
 * scripts/books/aurora.ts.
 */
import type { Book } from '../../lib/books';
import { languageLabel, languageName } from '../../lib/books';
import { byLanguage } from '../../lib/library';
import GlPayload from './GlPayload.astro';
import BookCaption from './BookCaption.astro';
import BookPicker from './BookPicker.astro';
import GlFallback from './GlFallback.astro';

interface Props {
  books: Book[];
}

const { books } = Astro.props;
/* The chapters, in the order the scene lays the books out (lib/glbooks, ordered()). */
const chapters = byLanguage(books).filter((g) => g.books.length);
---

<section class="aur" aria-label="The books" style={`--lead:0;--per:1;--n:${books.length + 1}`}>
  <div class="aur__stage">
    <div class="aur__shade" aria-hidden="true"></div>
    <div class="aur__head">
      <div class="aur__names" aria-hidden="true">
        <p class="aur__name aur__name--library">The library</p>
        {
          chapters.map((c) => (
            <p class="aur__name" lang={c.lang} dir={c.lang === 'ar' ? 'rtl' : 'ltr'}>
              {languageName[c.lang]}
            </p>
          ))
        }
      </div>
      <nav class="aur__langs" aria-label="Languages">
        {
          chapters.map((c, i) => (
            <button type="button" data-chapter={i}>
              {languageLabel[c.lang]}
            </button>
          ))
        }
      </nav>
    </div>
    <p class="aur__about" aria-hidden="true">
      Jurisprudence for Muslims in the West, dialogue between the Abrahamic faiths, the family and the unseen, in Arabic,
      English and Somali.
    </p>
    <BookCaption books={books} tone="dark" class="aur__caps" />
    <BookPicker books={books} />
  </div>
  <GlFallback books={books} />
  <GlPayload books={books} />
</section>

<style>
  .aur {
    position: relative;
    height: calc((var(--lead) + var(--per) * (var(--n) - 1) + 1) * 100svh);
  }

  /* Without the scene (no script, no WebGL) the page opens on its headline (LibraryHead.astro) and
     the books follow it. */
  .aur.no-gl,
  :global(html:not(.js)) .aur {
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  /* The night's own dark while the scene loads, so the page never flashes white. */
  .aur__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: #03060d;
  }

  .aur__stage :global(.gl__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }

  .aur__stage.is-hot :global(.gl__canvas) {
    cursor: pointer;
  }

  /* Night under the words, low on the left, ending before the chosen book so it takes none of its
     light; its opacity follows the dark (set by the script). */
  .aur__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(80% 110% at 0% 100%, oklch(7% 0.02 260 / 0.88), transparent 64%);
  }

  /* The chapter's title in the sky, and the three languages to go between them. The script shows
     one title at a time and fades the languages in with the night. */
  .aur__head {
    position: absolute;
    z-index: 3;
    top: calc(var(--nav-h) + clamp(0.4rem, 4vh, 2.2rem));
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  /* On a wide screen a chapter's title stays small above the book that stands close below it, and
     the box keeps the height of the tallest (the Arabic), so the languages' row does not move as
     the titles change; the library's larger name rises out of the box. */
  .aur__names {
    --arabic: clamp(2.6rem, 3.9vw, 4.1rem);
    display: grid;
    grid-template-rows: 100%;
    height: calc(var(--arabic) * 1.2);
  }

  /* Where the height is short the title makes way for the book (the script decides, fit()). */
  .aur__stage.is-short .aur__names {
    display: none;
  }

  .aur__name {
    grid-area: 1 / 1;
    align-self: end;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 3.6vw, 3.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    color: oklch(97% 0.01 85 / 0.9);
  }

  .aur__name:lang(ar) {
    font-family: var(--font-arabic);
    font-size: var(--arabic);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* The library's name, as the page opens, stands a little clear of the row. */
  .aur__name--library {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 5.2vw, 5.6rem);
  }

  :global(html.js) .aur__name,
  :global(html.js) .aur__langs,
  :global(html.js) .aur__about {
    visibility: hidden;
    opacity: 0;
  }

  /* Under the whole sky, a line on the works where a book's words stand in a chapter. */
  .aur__about {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: 3rem;
    width: min(25rem, 34vw);
    font-size: 1rem;
    line-height: 1.55;
    color: oklch(90% 0.012 85 / 0.82);
    text-shadow: 0 1px 10px oklch(8% 0.02 260 / 0.7);
    text-wrap: pretty;
    pointer-events: none;
  }

  /* On a very short screen (a phone on its side) the line would stand over the books. */
  @media (max-height: 500px) {
    .aur__about {
      display: none;
    }
  }

  .aur__langs {
    display: flex;
    gap: 2rem;
    margin-top: 1.1rem;
    pointer-events: auto;
  }

  /* A faint shadow keeps the words legible where they pass over a far book's cover. */
  .aur__langs button {
    padding: 0.35rem 0 0.3rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: oklch(92% 0.01 250 / 0.55);
    text-shadow: 0 1px 10px oklch(8% 0.02 260 / 0.7);
    transition: color 0.3s var(--ease-out);
  }

  .aur__langs button:hover,
  .aur__langs button:focus-visible {
    color: oklch(96% 0.006 85 / 0.85);
  }

  .aur__langs button[aria-current='true'] {
    color: oklch(98% 0.005 85);
    box-shadow: inset 0 -1px 0 currentColor;
  }

  .aur__stage :global(.aur__caps) {
    left: var(--gutter);
    top: calc(var(--nav-h) + 1rem);
    bottom: 3rem;
    width: min(27rem, 34vw);
    --bcap-align: end;
  }

  .aur.no-gl {
    height: auto;
  }

  .aur.no-gl .aur__stage,
  :global(html:not(.js)) .aur__stage {
    display: none;
  }

  /* Upright (phones, and tablets held upright) the words go under the book, and the script tilts
     the camera so the book clears them. */
  @media (max-width: 760px), (max-aspect-ratio: 4/5) {
    /* Upright the book has the width to itself below the titles, which keep their full size. */
    .aur__names {
      grid-template-rows: auto;
      height: auto;
    }

    .aur__name {
      align-self: center;
      margin-bottom: 0;
      font-size: clamp(3.4rem, 6.6vw, 7rem);
    }

    .aur__name:lang(ar) {
      font-size: clamp(3.6rem, 7vw, 7.4rem);
    }

    .aur__stage :global(.aur__caps) {
      right: var(--gutter);
      bottom: 1rem;
      width: auto;
    }

    .aur__about {
      right: var(--gutter);
      bottom: 1.5rem;
      width: auto;
      font-size: 0.92rem;
    }

    .aur__shade {
      background: linear-gradient(to top, oklch(8% 0.02 260 / 0.8), oklch(8% 0.02 260 / 0.45) 18%, transparent 28%);
    }
  }

  /* On a phone, a smaller title and one row for the first Amazon listing and "About this book",
     which holds the other formats. */
  @media (max-width: 760px) {
    .aur__langs {
      gap: 1.4rem;
    }

    .aur__langs button {
      font-size: 0.86rem;
    }

    /* The button and the link share a row where it holds both, and the link goes under it where not. */
    .aur__stage :global(.aur__caps .bcap__item) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: 1.2rem;
    }

    .aur__stage :global(.aur__caps .bcap__item > :is(p, h2)) {
      flex-basis: 100%;
    }

    .aur__stage :global(.aur__caps .bcap__links) {
      white-space: nowrap;
    }

    .aur__stage :global(.aur__caps .bcap__meta) {
      font-size: 0.78rem;
    }

    .aur__stage :global(.aur__caps .bcap__badge) {
      margin-top: 0.35rem;
      font-size: 0.78rem;
    }

    .aur__stage :global(.aur__caps .bcap__title) {
      margin-top: 0.3rem;
      font-size: 1.6rem;
    }

    .aur__stage :global(.aur__caps .bcap__title:lang(ar)) {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .aur__stage :global(.aur__caps .bcap__latin) {
      margin-top: 0.15rem;
      font-size: 0.86rem;
    }

    .aur__stage :global(.aur__caps .bcap__buy),
    .aur__stage :global(.aur__caps .bcap__links) {
      margin-top: 0.8rem;
    }

    .aur__stage :global(.aur__caps .bcap__buy .btn--ghost) {
      display: none;
    }
  }
</style>
