---
/**
 * The books on the home page: every book on a shelf, spine out, and one book beside it, each taking
 * half the width; the shelf grows to fill its half and the cover stands as tall as the shelf. The
 * new release stands there first; a click on a spine puts that book there instead, without leaving
 * the page, and its "About this book" opens it on the books page. Nothing is pinned and nothing
 * moves by itself. Phones hold the books as a fanned hand instead (WorksFan). Without the
 * script the spines are plain links to the books page.
 */
import { Image } from 'astro:assets';
import { allBooks, languageLabel } from '../lib/books';
import { LANGS, spineInfo } from '../lib/spines';
import Spine from './books/Spine.astro';
import WorksFan from './WorksFan.astro';

const all = await allBooks();
const infos = await Promise.all(all.map(spineInfo));
const groups = LANGS.map((L) => ({ ...L, spines: infos.filter((s) => s.lang === L.k) }));
const href = (id: string) => `/books?book=${id}`;
---

<section class="works" id="books" aria-labelledby="works-title">
  <div class="container works__grid">
    <div class="works__left">
      <h2 class="display works__h" id="works-title" data-split>
        Several works. <i>Three languages.</i>
      </h2>
      <p class="works__lede" data-reveal data-delay="0.15">
        Jurisprudence for Muslims in the West, dialogue between the Abrahamic faiths, the family and the unseen, in
        Arabic, English and Somali.
      </p>

      <div class="works__shelf" data-reveal data-delay="0.2">
        <div class="works__books">
          {
            groups.map((g) => (
              <div class="works__grp" role="group" aria-label={g.name}>
                <span class:list={['works__gl', g.k === 'ar' && 'is-ar']} lang={g.k} aria-hidden="true">
                  {g.name}
                </span>
                {g.spines.map((s) => (
                  <Spine s={s} tag="a" href={href(s.id)} max={15} />
                ))}
              </div>
            ))
          }
        </div>
        <div class="works__board" aria-hidden="true"></div>
      </div>

      <a class="link works__all works__all--shelf" href="/books">
        The whole library
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>

    <div class="works__stage" data-reveal data-delay="0.1" aria-live="polite">
      {
        all.map((b, i) => {
          const d = b.data;
          const ar = d.language === 'ar';
          const sub = ar ? d.titleEn : d.subtitle;
          return (
            <div class:list={['works__show', i === 0 && 'is-on']} data-show={b.id}>
              <div class="works__text">
                <p class="works__meta">
                  {d.badge ? (
                    <>
                      <em>{d.badge}</em> · {d.year}
                    </>
                  ) : (
                    `${languageLabel[d.language]} · ${d.year}`
                  )}
                </p>
                <h3 class:list={['works__title', ar && 'is-ar']} lang={d.language} dir={ar ? 'rtl' : 'ltr'}>
                  {d.title}
                </h3>
                {sub && <p class="works__sub">{sub}</p>}
                {d.role !== 'Author' && <p class="works__role">{d.role}</p>}
              </div>
              <a class="works__cover" href={href(b.id)} tabindex="-1" aria-hidden="true">
                <Image src={d.cover} alt="" widths={[360, 540, 720]} sizes="340px" loading={i === 0 ? 'eager' : 'lazy'} />
              </a>
              <div class="works__btns">
                  <a class="btn" href={d.amazon[0].url} target="_blank" rel="noopener">
                    Buy on Amazon
                    <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                      <path d="M4 12L12 4M6 4h6v6" />
                    </svg>
                  </a>
                  <a class="btn btn--ghost" href={href(b.id)}>
                    About this book
                  </a>
                </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <WorksFan />

  <div class="container works__all works__all--phone" data-reveal>
    <a class="btn btn--ghost" href="/books">
      All the works
      <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M2 8h11M9 4l4 4-4 4" />
      </svg>
    </a>
  </div>
</section>

<style>
  .works {
    position: relative;
    padding-block: clamp(6rem, 11vw, 10rem) clamp(4rem, 8vw, 7rem);
    background: var(--paper);
  }

  .works__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: end;
  }

  .works__h {
    font-size: clamp(2.4rem, 4.4vw, 4.4rem);
  }

  .works__lede {
    margin-top: 1.6rem;
    max-width: 26rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  /* ---------- the small shelf ---------- */

  .works__shelf {
    --s: 12.4;
    position: relative;
    width: max-content;
    margin-top: 4.5rem;
  }

  .works__books {
    display: flex;
    align-items: flex-end;
    gap: 1.4rem;
  }

  .works__grp {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1px;
  }

  .works__gl {
    position: absolute;
    left: 0;
    bottom: calc(24.41 * var(--s) * 1px + 0.9rem);
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .works__gl.is-ar {
    font-family: var(--font-arabic);
    font-size: 0.95rem;
  }

  .works__board {
    position: absolute;
    left: -1rem;
    right: -1rem;
    bottom: -12px;
    height: 12px;
    border-top: 1px solid var(--line-strong);
    background: linear-gradient(var(--paper-3), var(--paper));
  }

  .works__shelf :global(.spine:hover),
  .works__shelf :global(.spine:focus-visible),
  .works__shelf :global(.spine.is-on) {
    transform: translateY(-16px);
  }

  .works__all--shelf {
    margin-top: 3rem;
  }

  /* ---------- the book beside it ---------- */

  /* The cover with its buttons under it, the words beside it. */
  .works__show {
    display: none;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'cover text'
      'btns text';
    column-gap: clamp(1.5rem, 2.5vw, 2.5rem);
    align-items: end;
  }

  /* Only the shown book is laid out, so the others' covers load when they are asked for. */
  .works__show.is-on {
    display: grid;
    animation: works-show 0.22s ease-out;
  }

  @keyframes works-show {
    from {
      opacity: 0;
    }
  }

  .works__text {
    grid-area: text;
    max-width: 19rem;
    padding-bottom: 4.4rem;
  }

  .works__cover {
    grid-area: cover;
  }

  .works__meta {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .works__meta em {
    font-style: normal;
    color: var(--accent);
  }

  .works__title {
    margin: 1rem 0 0.9rem;
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .works__title.is-ar {
    font-family: var(--font-arabic);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .works__sub {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .works__role {
    margin-top: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .works__btns {
    grid-area: btns;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  .works__cover :global(img) {
    display: block;
    width: auto;
    max-width: none;
    height: var(--cover-h, min(460px, 52svh));
    border-radius: 1px 3px 3px 1px;
    box-shadow: var(--shadow-plate);
    transition: transform 0.5s var(--ease-out-quint);
  }

  .works__cover:hover :global(img) {
    transform: translateY(-8px);
  }

  .works__all--phone {
    display: none;
  }

  @media (max-width: 1100px) {
    .works__grid {
      grid-template-columns: 1fr;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .works__show.is-on {
      animation: none;
    }
  }

  /* ---------- phones: the fan (WorksFan) in its place ---------- */

  /* The same query as the fan's, turned round, so exactly one of them shows; a phone held
     sideways too (html.phone, Base.astro). */
  @media not all and (min-width: 760px) {
    html.js .works__shelf,
    html.js .works__stage,
    html.js .works__all--shelf {
      display: none;
    }

    html.js .works__all--phone {
      display: flex;
    }
  }

  html.js.phone .works__shelf,
  html.js.phone .works__stage,
  html.js.phone .works__all--shelf {
    display: none;
  }

  html.js.phone .works__all--phone {
    display: flex;
  }

  .works__all--phone {
    justify-content: center;
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }
</style>

<script>
  import { scrollToY } from '../scripts/smooth';

  /* A spine puts its book beside the shelf instead of leaving the page. */
  const shelf = document.querySelector<HTMLElement>('.works__shelf');
  const stage = document.querySelector<HTMLElement>('.works__stage');
  const spines = Array.from(document.querySelectorAll<HTMLAnchorElement>('.works__shelf .spine'));

  /* --s px per cm so the shelf fills its half (true proportions, at most 22, and no taller than half
     the screen so the section fits on one), and the cover as tall as the tallest book on it. */
  const THICK = spines.reduce((a, s) => a + parseFloat(s.style.getPropertyValue('--t')), 0);
  const TALLEST = Math.max(...spines.map((s) => parseFloat(s.style.getPropertyValue('--h'))));
  function fit() {
    const half = shelf?.parentElement;
    if (!shelf || !half || !half.clientWidth) return;
    const books = shelf.querySelector<HTMLElement>('.works__books')!;
    const gaps = (parseFloat(getComputedStyle(books).columnGap) || 0) * 2 + spines.length;
    const s = Math.max(10, Math.min(22, (half.clientWidth - gaps - 16) / THICK, (window.innerHeight * 0.5) / TALLEST));
    shelf.style.setProperty('--s', s.toFixed(2));
    stage?.style.setProperty('--cover-h', `${Math.round(TALLEST * s)}px`);
  }
  fit();
  window.addEventListener('resize', fit);

  const shows = Array.from(document.querySelectorAll<HTMLElement>('.works__show'));

  function pick(id: string) {
    shows.forEach((s) => s.classList.toggle('is-on', s.dataset.show === id));
    spines.forEach((s) => s.classList.toggle('is-on', s.dataset.open === id));
  }

  /* Fetch a cover as the pointer reaches its spine, so it is there by the click. */
  const warm = (id: string) =>
    shows.find((s) => s.dataset.show === id)?.querySelector('img')?.setAttribute('loading', 'eager');

  spines.forEach((s) => {
    s.addEventListener('pointerenter', () => warm(s.dataset.open!));
    s.addEventListener('focus', () => warm(s.dataset.open!));
    s.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      pick(s.dataset.open!);
      reveal();
    });
  });

  /* Below 1100px the book sits under the shelf: bring it up if the click left it out of sight. */
  function reveal() {
    const shown = shows.find((s) => s.classList.contains('is-on'));
    if (!shown) return;
    const r = shown.getBoundingClientRect();
    if (r.bottom > window.innerHeight + 40) scrollToY(window.scrollY + r.bottom - window.innerHeight + 32);
  }

  if (spines[0]) pick(spines[0].dataset.open!);
</script>
