---
/**
 * The wall. All eighteen covers hang as one mosaic that fills the viewport,
 * veiled and monochrome like an archive. Scrolling flies the camera into the
 * wall, stop by stop: the featured cover blooms to colour at full height with
 * its caption beside it, the camera lifts and crosses the wall to the next,
 * and at the end pulls all the way out to the whole library, lit and labelled.
 * The flight itself lives in scripts/motion.ts (works()).
 */
import { Image } from 'astro:assets';
import { allBooks, featuredBooks, caption, dominantColour } from '../lib/books';
import profile from '../data/profile.json';

/* The bookstore address lives in profile.json: his author store on Amazon UK. */
const store = profile.bookstore;

const all = await allBooks();
/* Three stops, one per row and one per language (see FEATURED in lib/books). */
const featured = featuredBooks(all);

/* The wall, row by row (book order numbers). The stops sit so the camera zig-zags. */
const layout = [
  [0, 4, 5, 6, 2, 7],
  [8, 9, 1, 10, 12, 11],
  [13, 3, 14, 16, 15, 17],
];
const cols = layout[0].length;

const tiles = await Promise.all(
  layout.flat().map(async (order) => {
    const entry = all.find((b) => b.data.order === order)!;
    return {
      entry,
      order,
      stop: featured.indexOf(entry),
      tint: await dominantColour(order),
      ...caption(entry),
    };
  })
);

const caps = featured.map((b, i) => ({ entry: b, i, ...caption(b) }));
---

<section class="works" id="books" aria-labelledby="works-title">
  <div class="container works__head">
    <h2 class="display display--lg" id="works-title" data-split>
      Several works. <em>Three languages.</em>
    </h2>
    <p class="works__lede" data-reveal data-delay="0.15">
      Jurisprudence for Muslims in the West, dialogue between the Abrahamic faiths, the family and the unseen, in
      Arabic, English and Somali.
    </p>
  </div>

  <div class="works__pin" style={`--cols:${cols}`}>
    <div class="works__stage">
      <div class="works__camera">
        <div class="works__grid">
          {
            tiles.map((t) => (
              <a
                class="works__tile"
                href={t.href}
                data-stop={t.stop}
                aria-label={`${t.entry.data.title}. Open the book`}
                style={`--tint:${t.tint}`}
              >
                <span class="works__img">
                  <Image
                    src={t.entry.data.cover}
                    alt=""
                    widths={[420, 640]}
                    sizes="(max-width: 760px) 44vw, 380px"
                    loading={t.stop >= 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="works__lbl" aria-hidden="true">
                  <span>{t.label}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="works__caps">
      {
        caps.map((c) => (
          <div class="works__cap" data-cap>
            {c.entry.data.badge && <p class="works__badge">{c.entry.data.badge}</p>}
            <h3 class="works__title display display--md" lang={c.entry.data.language}>
              {c.entry.data.title}
            </h3>
            {c.secondary && <p class="works__sec">{c.secondary}</p>}
            <p class="works__meta">{c.meta}</p>
            <p class="works__links">
              <a class="link" href={c.href}>
                Open the book
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <path d="M4 12L12 4M6 4h6v6" />
                </svg>
              </a>
              {
                store && (
                  <a class="link" href={store} target="_blank" rel="noopener">
                    Visit the bookstore
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                      <path d="M4 12L12 4M6 4h6v6" />
                    </svg>
                  </a>
                )
              }
            </p>
          </div>
        ))
      }
    </div>

    <div class="works__rail" aria-label="Jump to a book">
      <span class="works__rail-line" aria-hidden="true"><i class="works__rail-fill"></i></span>
      {
        caps.map((c) => (
          <button class="works__dot" type="button" data-go={c.i} aria-label={`Go to ${c.entry.data.title}`} />
        ))
      }
    </div>
  </div>

  <div class="container works__all" data-reveal>
    {
      store ? (
        <a class="btn btn--ghost" href={store} target="_blank" rel="noopener">
          Visit the bookstore
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" />
          </svg>
        </a>
      ) : (
        <a class="btn btn--ghost" href="/books">
          All the works
          <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" />
          </svg>
        </a>
      )
    }
  </div>
</section>

<style>
  .works {
    position: relative;
    padding-top: clamp(6rem, 12vw, 11rem);
    background: var(--paper);
  }

  .works__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem 4rem;
    align-items: end;
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .works__lede {
    max-width: 24rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  /* ---------- a tile ---------- */

  .works__tile {
    --lit: 1;
    display: block;
    color: inherit;
  }

  .works__img {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 2px;
    background: var(--tint);
    box-shadow:
      inset 0 0 0 1px oklch(0% 0 0 / 0.06),
      0 24px 50px -28px oklch(19% 0.012 60 / 0.55);
  }

  .works__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(calc(1 - var(--lit)));
  }

  /* Distance is a veil of paper, like a print not yet lit. */
  .works__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: calc((1 - var(--lit)) * var(--veil, 0.5));
    pointer-events: none;
  }

  /* Hover is set by the script (is-hover): see works() in motion.ts. */
  .works__tile.is-hover .works__img :global(img),
  .works__tile:focus-visible .works__img :global(img) {
    filter: none;
    transition: filter 0.45s var(--ease-out);
  }

  .works__tile.is-hover .works__img::after,
  .works__tile:focus-visible .works__img::after {
    opacity: 0;
    transition: opacity 0.45s var(--ease-out);
  }

  .works__lbl {
    display: flex;
    margin-top: 0.7rem;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
  }

  .works__lbl > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- captions ---------- */

  .works__badge {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
  }

  .works__cap .works__title {
    margin-top: 1rem;
    max-width: 22ch;
  }

  .works__cap .works__title[lang='ar'] {
    font-family: var(--font-arabic);
    font-weight: 400;
    font-size: clamp(2rem, 3.4vw, 3.3rem);
    line-height: 1.4;
    letter-spacing: 0;
    text-align: left;
  }

  .works__sec {
    margin-top: 0.7rem;
    font-weight: 300;
    font-size: 1.12rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .works__meta {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .works__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 1.5rem;
  }

  /* ---------- rail ---------- */

  .works__rail {
    display: none;
  }

  .works__rail-line {
    position: absolute;
    left: 0.35rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--line);
  }

  .works__rail-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: top;
  }

  .works__dot {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
  }

  .works__dot::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transform: translate(0.1rem, -50%);
    transition:
      background 0.4s,
      box-shadow 0.4s;
  }

  .works__dot:hover::after {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .works__dot.is-active::after {
    background: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .works__all {
    display: flex;
    justify-content: center;
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }

  /* ---------- flowing layout (small screens, reduced motion): the index ---------- */

  .works__pin:not(.is-3d) .works__grid {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 2.2rem 1.2rem;
    padding-block: 1rem 2rem;
  }

  .works__pin:not(.is-3d) .works__caps {
    display: none;
  }

  /* ---------- the flight (JS adds .is-3d) ---------- */

  .works__pin.is-3d {
    height: 100svh;
    overflow: hidden;
  }

  .is-3d .works__stage {
    position: absolute;
    inset: 0;
    perspective: 1800px;
    perspective-origin: 50% 50%;
  }

  .is-3d .works__camera {
    position: absolute;
    inset: 0;
    /* Flat, not preserve-3d: nothing inside has depth, and with preserve-3d Chrome's hit-testing
       misses the covers whenever the camera is tilted, so hover and clicks flickered. */
    transform-style: flat;
  }

  /* The wall is laid out big and scaled down, so zooming in never upscales a raster. */
  .is-3d .works__grid {
    --lbl: 0;
    --veil: 0.38;
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 380px);
    grid-auto-rows: 614px;
    gap: 26px;
    transform-origin: 0 0;
    will-change: transform;
  }

  .is-3d .works__tile {
    --lit: 0;
    width: 380px;
  }

  .is-3d.is-moving .works__grid {
    pointer-events: none;
  }

  .is-3d .works__img {
    height: 570px;
    box-shadow:
      inset 0 0 0 1px oklch(0% 0 0 / 0.06),
      0 40px 80px -40px oklch(19% 0.012 60 / 0.6);
    transition: box-shadow 1.2s var(--ease-out-quint);
  }

  /* The cover the camera has come to: its shadow deepens as if it had come off the wall. */
  .is-3d .works__tile.is-focus .works__img {
    box-shadow:
      inset 0 0 0 1px oklch(0% 0 0 / 0.06),
      0 70px 120px -50px oklch(19% 0.012 60 / 0.75);
  }

  .is-3d .works__lbl {
    margin-top: 14px;
    font-size: 1.15rem;
    opacity: var(--lbl);
  }

  .is-3d .works__caps {
    position: absolute;
    left: 60%;
    right: var(--gutter);
    top: 50%;
    display: grid;
    transform: translateY(-50%);
    pointer-events: none;
    isolation: isolate;
  }

  /* A pool of light on the wall behind the label, so it never fights a ghosted cover. */
  .is-3d .works__caps::before {
    content: '';
    position: absolute;
    inset: -34% -30% -34% -22%;
    z-index: -1;
    background: radial-gradient(ellipse at 42% 50%, var(--paper) 38%, transparent 72%);
    opacity: var(--spot, 0);
  }

  .is-3d .works__cap {
    grid-area: 1 / 1;
    max-width: 26rem;
    opacity: 0;
    visibility: hidden;
  }

  .is-3d .works__cap.is-active {
    pointer-events: auto;
  }

  .is-3d .works__rail {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  @media (max-width: 900px) {
    .works__head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .is-3d .works__caps {
      left: 56%;
    }
  }
</style>
