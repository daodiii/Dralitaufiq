---
/* Cookie notice. The site sets no cookies itself; the one optional extra is visit counting
   (Vercel Web Analytics, cookieless), loaded only after "Accept". The answer lives in localStorage. */
---

<div class="consent" id="consent" role="dialog" aria-label="Cookie notice" hidden>
  <p>
    This site only counts visits, with privacy-friendly statistics, if you agree. No advertising, no tracking across
    sites. <a href="/privacy">Privacy Policy</a>
  </p>
  <div class="consent__btns">
    <button type="button" data-consent="no">Decline</button>
    <button type="button" data-consent="yes" class="is-primary">Accept</button>
  </div>
</div>

<script>
  const KEY = 'cookie-consent';
  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const loadAnalytics = () => {
    if (document.querySelector('script[data-va]')) return;
    (window as any).va =
      (window as any).va ||
      function (...a: unknown[]) {
        ((window as any).vaq = (window as any).vaq || []).push(a);
      };
    const s = document.createElement('script');
    s.defer = true;
    s.src = '/_vercel/insights/script.js';
    s.dataset.va = '1';
    document.head.append(s);
  };

  const box = document.getElementById('consent') as HTMLElement;
  const saved = read();
  if (saved === 'yes') loadAnalytics();
  else if (saved !== 'no') box.hidden = false;

  box.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]');
    if (!b) return;
    const v = b.dataset.consent!;
    try {
      localStorage.setItem(KEY, v);
    } catch {}
    box.hidden = true;
    if (v === 'yes') loadAnalytics();
  });
</script>

<style>
  .consent {
    position: fixed;
    z-index: 200;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 34rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    padding: 1rem 1.2rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-plate);
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    flex: 1 1 16rem;
    margin: 0;
  }
  .consent a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .consent__btns {
    display: flex;
    gap: 0.5rem;
  }
  .consent button {
    font: inherit;
    font-weight: 500;
    padding: 0.55rem 1rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    cursor: pointer;
  }
  .consent button.is-primary {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .consent button:focus-visible,
  .consent a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
