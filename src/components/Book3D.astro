---
/**
 * A physical book: front cover (slotted image), spine with a vertical title,
 * page edge and back board. Rotate it with the --ry custom property.
 */
interface Props {
  ratio: number;
  spine: string;
  class?: string;
}

const { ratio, spine, class: className } = Astro.props;
---

<div class:list={['book3d', className]} style={`--ratio:${ratio}`}>
  <div class="book3d__back" aria-hidden="true"></div>
  <div class="book3d__pages" aria-hidden="true"></div>
  <div class="book3d__spine" aria-hidden="true"><span>{spine}</span></div>
  <div class="book3d__front">
    <slot />
    <div class="book3d__glare" aria-hidden="true"></div>
  </div>
</div>

<style>
  .book3d {
    --t: 26px;
    --ry: 0deg;
    position: relative;
    width: var(--w, 100%);
    aspect-ratio: var(--ratio, 0.667);
    transform-style: preserve-3d;
    transform: rotateY(var(--ry));
    transition: transform 0.9s var(--ease-cine);
  }

  .book3d__front,
  .book3d__back {
    position: absolute;
    inset: 0;
    border-radius: 2px 5px 5px 2px;
    background: var(--ink-3);
    overflow: hidden;
  }

  .book3d__front {
    transform: translateZ(calc(var(--t) / 2));
    box-shadow:
      inset 6px 0 10px -6px rgb(0 0 0 / 0.7),
      inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .book3d__front :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book3d__front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.28) 0, rgb(255 255 255 / 0.08) 3%, rgb(0 0 0 / 0.08) 6%, transparent 12%);
    pointer-events: none;
  }

  .book3d__glare {
    position: absolute;
    inset: -20%;
    background: radial-gradient(45% 40% at 35% 25%, rgb(255 255 255 / 0.35), transparent 70%);
    opacity: 0.22;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .book3d__back {
    transform: translateZ(calc(var(--t) / -2)) rotateY(180deg);
    background: linear-gradient(135deg, var(--ink-4), var(--ink-3));
  }

  .book3d__spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--t);
    transform-origin: left center;
    transform: translateZ(calc(var(--t) / -2)) rotateY(-90deg);
    background: linear-gradient(90deg, #2c2117 0%, #1b130d 60%, #241a11 100%);
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
  }

  .book3d__spine span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    max-height: 86%;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--brass-2);
    opacity: 0.85;
  }

  .book3d__pages {
    position: absolute;
    top: 2px;
    bottom: 2px;
    right: 0;
    width: var(--t);
    transform-origin: right center;
    transform: translateZ(calc(var(--t) / -2)) rotateY(90deg);
    background: repeating-linear-gradient(90deg, #ece2cf 0 1px, #d3c6ae 1px 2px, #e6dbc6 2px 3px);
  }
</style>
