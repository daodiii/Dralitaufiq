---
/**
 * The lectures on the home page: one whole screen, a single line of words at the top and under it
 * the six series he teaches on YouTube, one picture each, three by two. Each is a link to its
 * playlist. The retouched series photographs (assets/lectures/edited) are shared with the
 * mobile screen and lectures page; the original video stills remain in the assets directory.
 * Phones get "the screen" instead (LecturesScreen); without the script they keep the six.
 */
import { Image } from 'astro:assets';
import { SERIES, playlist, seriesMeta } from '../lib/lectures';
import quran from '../assets/lectures/edited/quran.jpg';
import sira from '../assets/lectures/edited/sira-wide.jpg';
import brief from '../assets/lectures/edited/brief.jpg';
import riyad from '../assets/lectures/edited/riyad.jpg';
import companions from '../assets/lectures/edited/companions.jpg';
import bulugh from '../assets/lectures/edited/bulugh.jpg';
import LecturesScreen from './LecturesScreen.astro';

/* The whole Qur'an first, then the rest. */
const SIX = [
  { key: 'quran', pic: quran },
  { key: 'sira', pic: sira },
  { key: 'brief', pic: brief },
  { key: 'riyad', pic: riyad },
  { key: 'companions', pic: companions },
  { key: 'bulugh', pic: bulugh },
] as const;

const six = SIX.map(({ key, pic }) => {
  const s = SERIES[key];
  return { key, pic, s, meta: seriesMeta(s), href: playlist(s.pl) };
});
---

<section class="lectures" id="lectures" aria-labelledby="lectures-title">
  <div class="container lectures__head" data-reveal>
    <h2 class="display lectures__h" id="lectures-title">Lessons on YouTube</h2>
    <p class="lectures__lede">
      Taught at the Tawfiiq Islamic Centre in Oslo: the whole Qur'an, ḥadīth and the life of the Prophet ﷺ. Free to
      watch, mostly in Somali.
    </p>
  </div>

  <ul class="container lectures__six">
    {
      six.map((x, i) => (
        <li data-reveal data-delay={(0.06 * i).toFixed(2)}>
          <a class="lectures__one" href={x.href} target="_blank" rel="noopener">
            <span class="lectures__pic">
              <Image
                src={x.pic}
                alt=""
                widths={[480, 800, 1280, 1600].filter((w) => w <= x.pic.width)}
                sizes="(max-width: 1100px) 46vw, 30vw"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="lectures__ar" lang="ar" dir="rtl">
              {x.s.ar}
            </span>
            <span class="lectures__t">{x.s.title}</span>
            <span class="lectures__m">
              {x.meta}
              <span class="sr-only"> on YouTube</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <LecturesScreen />

  <div class="container lectures__all">
    <a class="btn btn--ghost" href="/lectures">
      All the lectures
      <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M2 8h11M9 4l4 4-4 4"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* One whole screen, like Books: the line of words, the six, the link. */
  .lectures {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-block: calc(var(--nav-h) + clamp(0.75rem, 2.5vh, 2rem)) clamp(1.5rem, 4.5vh, 3.5rem);
  }

  /* One small line of words, title left and text right, as on Books. */
  .lectures__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2.5rem;
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .lectures__h {
    /* The heading line, the same on the home page, /books and /lectures. */
    font-size: clamp(1.6rem, 2.3vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .lectures__lede {
    max-width: 34rem;
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Keep every photograph's full 16:9 composition, including on shorter desktop screens. */
  .lectures__six {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: center;
    gap: clamp(1.5rem, 3.5vh, 2.5rem) clamp(1.25rem, 2vw, 2rem);
    margin-block: 0;
    list-style: none;
  }

  .lectures__one {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'pic pic'
      't ar'
      'm m';
    align-items: baseline;
    column-gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .lectures__pic {
    grid-area: pic;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-3);
  }

  .lectures__pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lectures__t {
    grid-area: t;
    margin-top: 0.85rem;
    font-size: clamp(1.02rem, 1.2vw, 1.18rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s;
  }

  .lectures__one:hover .lectures__t,
  .lectures__one:focus-visible .lectures__t {
    text-decoration-color: currentColor;
  }

  .lectures__ar {
    grid-area: ar;
    font-family: var(--font-arabic);
    font-size: 1.05rem;
    color: var(--gold-3);
    white-space: nowrap;
  }

  .lectures__m {
    grid-area: m;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .lectures__all {
    display: flex;
    justify-content: center;
    padding-top: clamp(1.5rem, 4vh, 3rem);
  }

  /* Narrower screens: two by three, pictures in their own proportion. */
  @media (max-width: 1100px) {
    .lectures__six {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lectures__pic {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  /* A phone has the screen (LecturesScreen) in its place: the same query as the screen's, turned
     round, and a phone held sideways too (html.phone, Base.astro). */
  @media not all and (min-width: 760px) {
    html.js .lectures__six {
      display: none;
    }

    .lectures {
      min-height: 0;
    }
  }

  html.js.phone .lectures__six {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lectures__pic :global(img) {
      transition: none;
    }
  }
</style>
