---
/**
 * The lectures page, "the reading room" (picked as R8-B, 2026-11-22), at night since 2026-11-23: the
 * site's three colours are white, black and gold, so the bands that were cream are black (#0c0b09, the
 * hero's and the books vitrine's black). A black band with one lit screen, the whole Qur'an explained, beside the
 * programme of all seven series; then on white paper that series opened (its first lessons and every sūrah), the Companions by name, the other series,
 * and the talks in English and Somali, each language under a short band of its own.
 *
 * Every picture of him is one checked by eye: a lesson's own chosen frame (lib/stills.ts, data
 * `f`/`fv`) where it was checked again for this page (mouth closed or smiling, docs/research/
 * subjects-and-books-round-2026-11-22). Enhanced versions now cover every displayed lesson and
 * talk card. Every lesson, sūrah and name opens on YouTube inside its playlist.
 */
import LESSONS from '../data/lessons.json';
import { SERIES, ROOM, mins, playlist, video, watch, type Lesson, type Lessons } from '../lib/lectures';
import { still, pictureOf } from '../lib/stills';
import { SURAHS } from '../lib/surahs';
import * as T from '../lib/talks';

const data = LESSONS as Lessons;
const pl = (key: string) => data[key].pl;

/* Two additional early lessons, alongside the opening lessons in teaching order. */
const QURAN_EXTRA = new Set([17, 18]);

const photo = (name: string, width: number = 480) => `/lecture-portraits/${name}-${width}.webp`;
const photoSet = (name: string) => [480, 960, 1600].map((w) => `${photo(name, w)} ${w}w`).join(', ');

const pic = (l: Lesson) => {
  const p = pictureOf(l);
  return { src: still(p.id, p.f, 'mq') };
};

const LINES: Record<string, string> = {
  quran: '330 lessons, about 406 hours, sūrah by sūrah',
  brief: '115 lessons, the whole Qur’an in short',
  sira: '51 lessons',
  companions: '106 lessons, one Companion at a time',
  riyad: '151 lessons',
  bulugh: 'Still being taught',
  hisn: '4 lessons',
};

/* Series artwork is shared with the homepage. Individual lesson tiles keep their own frames. */
const series = ROOM.map((key) => {
  const photoName = key === 'sira' ? 'sira-wide' : key;
  return {
    key, s: SERIES[key], line: LINES[key], photoName,
    lead: { src: photo(photoName, 1600) },
    small: { src: photo(photoName) },
  };
});
const Q = series[0];
const firstQ = data.quran.lessons[0];

/* The Qur'an opened: its first twelve lessons, in order. */
const opened = data.quran.lessons
  .filter((l) => l.n <= 13 || QURAN_EXTRA.has(l.n))
  .filter((l) => l.n !== 11 && l.n !== 13)
  .slice(0, 12)
  .map((l) => ({ l, href: watch(l.id, pl('quran')), pic: pic(l) }));

/* Every sūrah that has lessons, opening the lesson where it begins. */
const surahs: { name: string; ar: string; href: string }[] = [];
for (const l of data.quran.lessons) {
  if (!l.s || surahs.some((x) => x.name === SURAHS[l.s! - 1][0])) continue;
  surahs.push({ name: SURAHS[l.s - 1][0], ar: SURAHS[l.s - 1][1], href: watch(l.id, pl('quran')) });
}

/* The Companions by name, each opening the first lesson about them. */
const companions: { name: string; href: string }[] = [];
for (const l of data.companions.lessons) {
  if (l.w && !companions.some((c) => c.name === l.w)) companions.push({ name: l.w, href: watch(l.id, pl('companions')) });
}

const others = ['brief', 'sira', 'riyad', 'bulugh', 'hisn'].map((key) => ({
  ...series.find((x) => x.key === key)!,
  first: data[key].lessons.slice(0, 3).map((l) => ({ t: l.t, len: mins(l.m), href: watch(l.id, pl(key)) })),
}));

/* Every talk has an enhanced frame from that recording, including the former text tiles. */
const talkPic = (id: string) => photo(`talk-${id}`);

const languages = [
  { id: 'talks-en', line: T.EN_LINE, talks: T.EN_TALKS, lit: 3, all: playlist(T.EN_PLAYLIST), count: T.EN_COUNT },
  { id: 'talks-so', line: T.SO_LINE, talks: T.SO_TALKS, lit: 3, all: playlist(T.SO_PLAYLIST), count: T.SO_COUNT },
];
const prophet = (s: string) => s.split('ﷺ');
---

<section class="lr-top lr-room" aria-labelledby="lr-title">
  <script is:inline>
    /* ?series=<key> or #t-<key> (the old page's links) lands on that series. */
    (function () {
      var k = new URLSearchParams(location.search).get('series') || (location.hash.indexOf('#t-') === 0 ? location.hash.slice(3) : '');
      if (k) addEventListener('load', function () { var el = document.getElementById('s-' + k); if (el) el.scrollIntoView(); });
    })();
  </script>
  <div class="container lr-head">
    <h1 id="lr-title">The lectures</h1>
    <p>Every lesson on YouTube, series by series, with his talks in English and Somali.</p>
  </div>
  <div class="container lr-top__in">
    <div class="lr-screen">
      <a class="lr-fr lr-fr--lit" href={watch(firstQ.id, pl('quran'))} aria-label={`${Q.s.title}: begin`}>
        <img src={Q.lead.src} srcset={photoSet(Q.photoName)} sizes="(max-width: 760px) 92vw, 60vw" alt="" width="1600" height="900" fetchpriority="high" />
      </a>
      <h2 class="lr-screen__t">{Q.s.title}<span lang="ar" dir="rtl">{Q.s.ar}</span></h2>
      <p class="lr-dim">{Q.line}</p>
      <a class="link lr-begin" href={watch(firstQ.id, pl('quran'))}>Begin: {firstQ.t} →</a>
    </div>
    <nav class="lr-prog" aria-label="The lesson series">
      <p class="lr-prog__hd lr-dim">Seven lesson series, taught in Somali</p>
      {
        series.map((x, i) => (
          <a class:list={['lr-prog__row', i === 0 && 'is-on']} href={`#s-${x.key}`}>
            <span class="lr-fr">
              <img src={x.small.src} alt="" width="320" height="180" loading="lazy" />
            </span>
            <span class="lr-prog__txt">
              <b>{x.s.title}</b>
              <span class="lr-prog__ar" lang="ar" dir="rtl">{x.s.ar}</span>
              <span class="lr-dim">{x.line}</span>
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<div class="container lr-paper">
  <section class="lr-open" id="s-quran" aria-label={Q.s.title}>
    <div>
      <p class="lr-hd"><b>{Q.s.title}</b>, from the start</p>
      <div class="lr-g4">
        {
          opened.map(({ l, href, pic: p }) => (
              <a class="lr-les" href={href}>
                <span class="lr-fr"><img src={p.src} alt="" width="480" height="270" loading="lazy" decoding="async" /></span>
                <b>{l.t}</b>
                <span class="lr-meta">Lesson {l.n} · {mins(l.m)}</span>
              </a>
            )
          )
        }
      </div>
      <a class="link lr-all" href={playlist(pl('quran'))}>All 330 lessons</a>
    </div>
    <div class="lr-sur">
      <details class="lr-sur__d" open>
        <summary class="lr-hd">Or open a sūrah</summary>
        <div class="lr-sidx">
          {surahs.map((x) => (
            <a href={x.href}><span>{x.name}</span><i lang="ar" dir="rtl">{x.ar}</i></a>
          ))}
        </div>
      </details>
      <script is:inline>
        /* On a phone the sūrahs fold away under their heading. */
        if (matchMedia('(max-width: 760px)').matches) document.currentScript.previousElementSibling.removeAttribute('open');
      </script>
    </div>
  </section>

  <section class="lr-comp" id="s-companions" aria-label={SERIES.companions.title}>
    <div>
      {(() => { const x = series.find((s) => s.key === 'companions')!; return (
        <span class="lr-fr"><img src={x.lead.src} srcset={photoSet(x.photoName)} sizes="(max-width: 760px) 92vw, 30vw" alt="" width="1600" height="900" loading="lazy" /></span>
      ); })()}
      <h3 class="lr-h3">{SERIES.companions.title}<span lang="ar" dir="rtl">{SERIES.companions.ar}</span></h3>
      <p class="lr-meta">{LINES.companions}</p>
      <a class="link lr-all" href={playlist(pl('companions'))}>All 106 lessons</a>
    </div>
    <div class="lr-names">
      {companions.slice(0, 40).map((c) => <a href={c.href}>{c.name}</a>)}
    </div>
  </section>

  <section class="lr-others">
    {
      others.map((x) => (
        <div class="lr-ser" id={`s-${x.key}`}>
          <span class="lr-fr">
            <img src={x.lead.src} srcset={photoSet(x.photoName)} sizes="(max-width: 760px) 44vw, 18vw" alt="" width="1600" height="900" loading="lazy" />
          </span>
          <h3 class="lr-h3">{x.s.title}<span lang="ar" dir="rtl">{x.s.ar}</span></h3>
          <p class="lr-meta">{x.line}</p>
          <ul>
            {x.first.map((l) => (
              <li><a href={l.href}>{l.t}<span>{l.len}</span></a></li>
            ))}
          </ul>
          <a class="link lr-all" href={playlist(pl(x.key))}>{x.key === 'bulugh' ? 'All lessons so far' : `All ${x.s.count} lessons`}</a>
        </div>
      ))
    }
  </section>
</div>

{
  languages.map((g) => {
    const lit = g.talks.slice(0, g.lit);
    const rest = g.talks.filter((t) => !lit.includes(t));
    return (
      <>
        <section class="lr-room lr-band" id={`s-${g.id}`} aria-label={g.id === 'talks-en' ? 'Talks in English' : 'Talks in Somali'}>
          <div class="container">
            <p class="lr-dim lr-band__line">{g.line}</p>
            <div class="lr-three">
              {lit.map((t) => (
                <a class="lr-tk" href={video(t.id)}>
                  <span class="lr-fr lr-fr--lit"><img src={talkPic(t.id)} srcset={photoSet(`talk-${t.id}`)} alt="" width="1600" height="900" sizes="(max-width: 760px) 92vw, 30vw" loading="lazy" decoding="async" /></span>
                  <b>{prophet(t.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}</b>
                  <span class="lr-dim">{[t.len, t.place].filter(Boolean).join(' · ')}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
        <div class="container lr-paper lr-paper--talks">
          <div class="lr-ledger">
            {rest.map((t) => (
              <a class="lr-lr" href={video(t.id)}>
                <span class="lr-fr"><img src={talkPic(t.id)} srcset={photoSet(`talk-${t.id}`)} alt="" width="1600" height="900" sizes="112px" loading="lazy" decoding="async" /></span>
                <b>{prophet(t.title).map((p, i) => (i ? [<bdi>ﷺ</bdi>, p] : p))}</b>
                <span>{[t.place, t.len].filter(Boolean).join(' · ')}</span>
              </a>
            ))}
          </div>
          <div class="lr-more">
            {g.id === 'talks-en' ? (
              <p><i>Short answers:</i> {T.EN_ANSWERS.map((a, i) => <>{i ? ' · ' : ''}<a href={video(a.id)}>{a.title}</a></>)}</p>
            ) : (
              T.SO_GROUPS.map((gr) => (
                <p><i>{gr.title}:</i> {gr.parts.map((p, i) => <>{i ? ' · ' : ''}<a href={video(p.id)}>{p.title}</a></>)}</p>
              ))
            )}
            <p><a class="link lr-yt" href={g.all}>All {g.count} on YouTube ↗</a></p>
          </div>
        </div>
      </>
    );
  })
}

<script>
  import { nav, showNav } from '../scripts/nav';
  import { reveals } from '../scripts/reveals';

  nav();
  showNav();
  reveals();
</script>

<style>
  /* The room at night: black bands, light words, gold Arabic and rules. White paper between. */
  .lr-room {
    --cream: #f6efe2;
    --cream-2: #a9a192;
    --rule: rgb(246 239 226 / 0.12);
    --gold: #d9b45a;
    --gold-3: #d9b45a;
    --accent: #d9b45a;
    --link-ink: var(--cream);
    position: relative;
    color: var(--cream);
    background: #0c0b09;
    border-top: 1px solid rgb(217 180 90 / 0.35);
    border-bottom: 1px solid rgb(217 180 90 / 0.35);
  }
  :global(html.lectures-night) { background: #0c0b09; }
  .lr-dim { color: var(--cream-2); }
  .lr-top { padding: calc(var(--nav-h) + 2.2rem) 0 3.2rem; border-top: 0; }
  /* The heading line, as on the home page and /books. */
  .lr-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem 2.5rem; margin-bottom: 2.4rem; }
  .lr-head h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.6rem, 2.3vw, 2.3rem); letter-spacing: -0.035em; line-height: 1.1; color: var(--cream); white-space: nowrap; }
  .lr-head p { max-width: 34rem; font-size: clamp(1rem, 1.15vw, 1.12rem); line-height: 1.5; color: var(--cream-2); text-wrap: pretty; }
  .lr-top__in { display: grid; grid-template-columns: minmax(0, 820fr) minmax(0, 404fr); gap: 3rem; align-items: start; }

  .lr-fr { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 2px; background: #0c0b09; }
  .lr-fr img { width: 100%; height: 100%; object-fit: contain; }
  .lr-fr--lit { box-shadow: none; }

  .lr-screen__t { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1.25rem; font-size: 1.625rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; }
  .lr-screen__t span { font-family: var(--font-arabic); font-size: 1.5rem; font-weight: 400; color: var(--gold-3); }
  .lr-screen p { margin-top: 0.25rem; font-size: 0.875rem; }
  .lr-begin { margin-top: 1rem; }

  .lr-prog__hd { font-size: 0.8125rem; padding: 0 0 0.625rem 0.875rem; border-bottom: 1px solid var(--rule); }
  .lr-prog__row { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 1rem; align-items: center; padding: 0.5rem 0 0.5rem 0.875rem; border-bottom: 1px solid var(--rule); color: var(--cream); }
  .lr-prog__row .lr-fr { box-shadow: 0 0 0 1px rgb(246 239 226 / 0.08); }
  .lr-prog__row.is-on .lr-fr, .lr-prog__row:hover .lr-fr, .lr-prog__row:focus-visible .lr-fr { filter: none; }
  .lr-prog__row.is-on::before { content: ''; position: absolute; left: 0; top: 0.625rem; bottom: 0.625rem; width: 2px; background: var(--gold); }
  .lr-prog__txt b { display: block; font-size: 0.97rem; font-weight: 500; line-height: 1.25; }
  .lr-prog__ar { display: block; font-family: var(--font-arabic); font-size: 0.95rem; line-height: 1.35; color: var(--gold-3); }
  .lr-prog__txt .lr-dim { display: block; font-size: 0.78rem; }

  .lr-paper { padding-top: 3rem; }
  .lr-hd { font-size: 0.97rem; color: var(--ink-2); margin-bottom: 1.125rem; list-style: none; }
  .lr-hd b { color: var(--ink); font-weight: 600; }
  .lr-open { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 2.5rem; }
  .lr-g4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
  .lr-les { display: block; color: var(--ink); }
  .lr-les > b { display: block; font-size: 0.84rem; font-weight: 500; line-height: 1.3; margin-top: 0.5rem; }
  .lr-meta { display: block; font-size: 0.78rem; color: var(--ink-3); }
  .lr-all { margin-top: 0.875rem; }

  .lr-sur__d summary { cursor: default; }
  .lr-sur__d summary::-webkit-details-marker { display: none; }
  .lr-sidx { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: column; grid-template-rows: repeat(41, auto); column-gap: 1.125rem; font-size: 0.78rem; line-height: 1.09rem; }
  .lr-sidx a { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; border-bottom: 1px solid var(--line); color: var(--ink); }
  .lr-sidx a span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lr-sidx a i { font-style: normal; font-family: var(--font-arabic); font-size: 0.82rem; color: var(--gold-3); white-space: nowrap; }
  .lr-sidx a:hover span { color: var(--accent); }

  .lr-comp { display: grid; grid-template-columns: minmax(0, 416fr) minmax(0, 880fr); gap: 2.5rem; margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--line-strong); }
  .lr-h3 { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-top: 0.875rem; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }
  .lr-h3 span { font-family: var(--font-arabic); font-size: 1.2rem; font-weight: 400; color: var(--gold-3); white-space: nowrap; }
  .lr-names { columns: 4; column-gap: 1.5rem; font-size: 0.84rem; line-height: 1.85; }
  .lr-names a { display: block; color: var(--ink); break-inside: avoid; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lr-names a:hover { color: var(--accent); }

  .lr-others { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--line-strong); }
  .lr-ser ul { list-style: none; margin: 0.625rem 0 0; padding: 0; font-size: 0.84rem; }
  .lr-ser li a { display: flex; justify-content: space-between; gap: 0.625rem; padding: 0.375rem 0; border-top: 1px solid var(--line); color: var(--ink); }
  .lr-ser li span { color: var(--ink-3); white-space: nowrap; }

  .lr-band { margin-top: 5rem; padding: 2.1rem 0 2.5rem; }
  .lr-band__line { font-size: 0.94rem; margin-bottom: 1.125rem; }
  .lr-three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem; }
  .lr-tk { display: block; color: var(--cream); }
  .lr-tk b { display: block; margin-top: 0.875rem; font-size: 1.15rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
  .lr-tk .lr-dim { display: block; font-size: 0.84rem; margin-top: 0.125rem; }
  .lr-fr :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .lr-paper--talks { padding-top: 1.125rem; }
  .lr-ledger { display: grid; grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
  .lr-lr { display: grid; grid-template-columns: 112px minmax(0, 1fr) auto; gap: 1rem; align-items: center; min-height: 4rem; padding: 0.375rem 0; border-bottom: 1px solid var(--line); color: var(--ink); }
  .lr-lr .lr-fr { width: 112px; }
  .lr-lr b { font-size: 0.97rem; font-weight: 500; line-height: 1.3; }
  .lr-lr > span:last-child { font-size: 0.8125rem; color: var(--ink-3); white-space: nowrap; }
  .lr-lr:hover b { color: var(--accent); }
  .lr-more { margin-top: 1.125rem; font-size: 0.94rem; color: var(--ink-2); line-height: 1.9; }
  .lr-more i { font-style: normal; color: var(--ink-3); }
  .lr-more a:not(.link) { color: var(--ink); border-bottom: 1px solid color-mix(in srgb, var(--gold-line) 70%, transparent); }
  .lr-more a:not(.link):hover { border-bottom-color: var(--gold-mid); }
  .lr-paper--talks:last-of-type { padding-bottom: 7rem; }
  bdi { font-family: var(--font-arabic); }

  @media (max-width: 1100px) {
    .lr-top__in { grid-template-columns: minmax(0, 1fr) 340px; gap: 1.75rem; }
    .lr-names { columns: 3; }
    .lr-others { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; }
    .lr-g4 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .lr-top { padding: calc(var(--nav-h) + 1.25rem) 0 1.75rem; }
    .lr-head { margin-bottom: 1.5rem; }
    .lr-top__in { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .lr-prog { color: var(--cream); }
    .lr-open { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .lr-g4 { grid-template-columns: 1fr 1fr; gap: 1.125rem 0.875rem; }
    .lr-g4 .lr-les:nth-child(n + 7) { display: none; }
    .lr-sur__d summary { display: flex; justify-content: space-between; padding: 0.875rem 0; margin: 0; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); font-weight: 500; color: var(--ink); cursor: pointer; }
    .lr-sur__d summary::after { content: '+'; }
    .lr-sur__d[open] summary::after { content: '−'; }
    .lr-sidx { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(41, auto); font-size: 0.84rem; line-height: 1.75rem; }
    .lr-comp { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 2.75rem; }
    .lr-names { columns: 2; }
    .lr-others { grid-template-columns: minmax(0, 1fr); gap: 2.25rem; margin-top: 2.75rem; }
    .lr-ser li:nth-child(n + 2) { display: none; }
    .lr-band { margin-top: 3.5rem; }
    .lr-three { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .lr-ledger { grid-template-columns: minmax(0, 1fr); }
    .lr-lr { grid-template-columns: 88px minmax(0, 1fr); gap: 0.25rem 0.875rem; }
    .lr-lr .lr-fr { width: 88px; grid-row: span 2; }
    .lr-lr > span:last-child { grid-column: 2; }
  }
</style>
