---
/**
 * The profile, "the parting". Two pages fill the viewport and meet at a
 * hairline: his formation on the left and his posts today on the right, as
 * hairline records set against the seam. Scrolling parts the pages, and
 * standing between them is his portrait, still; his mission then writes
 * itself across the foot of both. Below the pin, the biography on a card of
 * the hero's warmer paper, his gilded name above it. Phones and reduced
 * motion get the same content stacked, without the pin.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/about/portrait-studio.jpg';
import calligraphy from '../assets/hero/calligraphy-name.png';
import profile from '../data/profile.json';

const formation = profile.timeline.filter((t) => t.year !== 'Today');
const words = profile.mission.split(' ');
const [lead, ...body] = profile.aboutLead;
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container about__head">
    <h2 class="display display--lg" id="about-title" data-split>{profile.aboutHeadline}</h2>
  </div>

  <div class="about__pin">
    <div class="about__stage">
      <figure class="about__between">
        <div class="about__photo">
          <Image
            src={portrait}
            alt="Prof. Dr. Ali Mohamed Salah"
            widths={[520, 800]}
            sizes="(max-width: 900px) 60vw, 26vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__caption">
          <span lang="ar">{profile.nameArabic}</span>
          <span>{profile.name}</span>
        </figcaption>
      </figure>

      <div class="about__page about__page--l">
        <p class="about__tag">Formation</p>
        <div class="about__slot">
          <div class="about__records about__records--l">
            <dl class="about__rows">
              {
                formation.map((t) => (
                  <div class="about__row">
                    <dt>{t.year}</dt>
                    <dd>
                      <span>{t.title}</span>
                      <span class="about__where">{t.where}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <div class="about__page about__page--r">
        <p class="about__tag">Today</p>
        <div class="about__slot">
          <div class="about__records about__records--r">
            <dl class="about__rows">
              {
                profile.roles.map((r) => (
                  <div class="about__row about__row--role">
                    <dt>{r.title}</dt>
                    <dd>{r.org}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="about__past">
              Earlier: {profile.past.join('; ')}. He writes in Arabic, English and Somali, and teaches also in Norwegian
              and Malay.
            </p>
          </div>
        </div>
      </div>

      <blockquote class="about__mission">
        <p>
          {words.map((w) => (
            <>
              <span class="about__w">{w}</span>{' '}
            </>
          ))}
        </p>
      </blockquote>
    </div>
  </div>

  <div class="container about__bio">
    <div class="about__card" data-reveal data-delay="0.1" style={`--calli: url(${calligraphy.src})`}>
      <span class="about__calli" role="img" aria-label={profile.nameArabic}></span>
      <p class="about__lead">{lead}</p>
      {body.map((p) => <p class="about__body">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: clamp(6rem, 13vw, 12rem);
  }

  .about__head {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .about__head h2 {
    max-width: 22ch;
  }

  .about__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .about__photo {
    overflow: hidden;
    border-radius: 3px;
    background: var(--paper-3);
    box-shadow: var(--shadow-plate);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 10%;
  }

  .about__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.8rem;
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .about__caption [lang='ar'] {
    font-size: 1.05rem;
    color: var(--ink);
    text-align: left;
  }

  /* ---------- the records ---------- */

  .about__records {
    display: grid;
    align-content: center;
    gap: 1.5rem;
    height: 100%;
    max-width: 30rem;
  }

  .about__records--l {
    justify-self: end;
  }

  .about__rows {
    display: grid;
  }

  .about__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.5rem 1.4rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  .about__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .about__row--role {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  }

  .about__row dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    padding-top: 0.15rem;
  }

  .about__row--role dt {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    padding-top: 0;
  }

  .about__row dd {
    display: grid;
    gap: 0.2rem;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .about__row--role dd {
    color: var(--ink-3);
  }

  .about__where {
    font-size: 0.86rem;
    color: var(--ink-3);
  }

  .about__past {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  .about__mission p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.1vw, 2.1rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* ---------- the biography, framed ---------- */

  .about__bio {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 10vw, 9rem);
  }

  .about__card {
    max-width: 54rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 5vw, 5rem);
    text-align: center;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow:
      0 1px 2px oklch(19% 0.012 60 / 0.04),
      0 30px 70px -36px oklch(19% 0.012 60 / 0.3);
  }

  .about__calli {
    display: block;
    width: min(11rem, 50%);
    aspect-ratio: 885 / 310;
    margin: 0 auto clamp(1.6rem, 3vw, 2.4rem);
    background-image: linear-gradient(
      112deg,
      var(--gold-3) 0%,
      var(--gold) 30%,
      var(--gold-2) 50%,
      var(--gold) 70%,
      var(--gold-3) 100%
    );
    background-size: 220% 100%;
    -webkit-mask: var(--calli) center / contain no-repeat;
    mask: var(--calli) center / contain no-repeat;
  }

  .about__lead {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }

  .about__body {
    max-width: 40rem;
    margin: clamp(1.2rem, 2vw, 1.7rem) auto 0;
    font-size: 1.02rem;
    line-height: 1.66;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ---------- flowing layout (small screens, reduced motion) ---------- */

  .about__pin:not(.is-live) .about__stage {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
  }

  .about__pin:not(.is-live) .about__between {
    margin: 0;
    width: min(18rem, 70vw);
  }

  .about__pin:not(.is-live) .about__photo {
    aspect-ratio: 4 / 5;
  }

  .about__pin:not(.is-live) .about__page {
    display: grid;
    gap: 0.8rem;
  }

  .about__pin:not(.is-live) .about__records {
    height: auto;
    justify-self: start;
  }

  /* ---------- the parting (JS adds .is-live) ---------- */

  .about__pin.is-live {
    --gap: 0;
    --fade: 0;
    height: 100svh;
    overflow: hidden;
  }

  .is-live .about__stage {
    position: absolute;
    inset: 0;
  }

  .is-live .about__between {
    position: absolute;
    left: 50%;
    top: 45%;
    width: min(26vw, 380px);
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .is-live .about__photo {
    height: min(56svh, 560px);
  }

  .is-live .about__caption {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  /* The two pages. They cover the portrait, then slide off it. */
  .is-live .about__page {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    padding: calc(var(--nav-h) + 1rem) var(--gutter) 2rem;
    background: var(--paper);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.6rem;
    z-index: 2;
  }

  .is-live .about__page--l {
    left: 0;
    border-right: 1px solid var(--line);
    transform: translateX(calc(var(--gap) * -14vw));
  }

  .is-live .about__page--r {
    right: 0;
    transform: translateX(calc(var(--gap) * 14vw));
  }

  .is-live .about__page--r .about__tag {
    text-align: right;
  }

  .is-live .about__slot {
    grid-row: 2;
    min-height: 0;
    opacity: calc(1 - var(--fade) * 0.72);
  }

  .is-live .about__mission {
    position: absolute;
    left: 50%;
    bottom: 5svh;
    z-index: 3;
    width: min(46rem, 88vw);
    transform: translateX(-50%);
    text-align: center;
    pointer-events: none;
  }

  .is-live .about__mission::before {
    content: '';
    position: absolute;
    inset: -40% -18%;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 50%, var(--paper) 40%, transparent 72%);
    opacity: var(--fade);
  }

  .is-live .about__w {
    opacity: 0;
    display: inline-block;
    transform: translateY(0.35em);
  }

  @media (max-width: 760px) {
    .about__card {
      border-radius: 16px;
    }
  }

  @media (max-width: 900px) {
    .is-live .about__between {
      width: min(40vw, 300px);
    }

    .is-live .about__page--l {
      transform: translateX(calc(var(--gap) * -22vw));
    }

    .is-live .about__page--r {
      transform: translateX(calc(var(--gap) * 22vw));
    }
  }
</style>
