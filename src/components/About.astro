---
/**
 * The profile. Headline, a monochrome plate that blooms into colour on hover,
 * the biography, his mission, and the road from Madinah to Oslo drawn on scroll.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/about/portrait-studio.jpg';
import profile from '../data/profile.json';

const stops = [
  { city: 'Madinah', year: '1991', note: 'B.A., Ḥadīth and Islamic Studies', x: 70, y: 168 },
  { city: 'Makkah', year: '1994', note: 'M.A., Islamic Theology', x: 335, y: 92 },
  { city: 'Kuala Lumpur', year: '2000', note: 'Ph.D., Theology and Comparative Religion', x: 600, y: 158 },
  { city: 'Ås', year: '2012', note: 'International Relations, NMBU', x: 860, y: 84 },
  { city: 'Oslo', year: 'Today', note: 'Professor, imam and khaṭīb', x: 1125, y: 132 },
];
const d = 'M70 168 C170 168 235 92 335 92 S500 158 600 158 S760 84 860 84 S1025 132 1125 132';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <h2 class="display display--lg about__title" id="about-title" data-split>{profile.aboutHeadline}</h2>

    <figure class="about__plate" data-reveal data-y="36">
      <div class="about__photo">
        <Image
          src={portrait}
          alt="Prof. Dr. Ali Mohamed Salah"
          widths={[520, 800, 1100]}
          sizes="(max-width: 900px) 80vw, 28vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="about__caption">
        <span lang="ar">{profile.nameArabic}</span>
        <span>{profile.city}</span>
      </figcaption>
    </figure>

    <div class="about__body prose" data-reveal data-delay="0.1">
      {profile.aboutLead.map((p) => <p>{p}</p>)}
    </div>

    <blockquote class="about__mission" data-reveal data-delay="0.15">
      <p>{profile.mission}</p>
    </blockquote>

    <div class="journey">
      <p class="journey__label" data-reveal>Formation</p>
      <div class="journey__map">
        <svg class="journey__svg" viewBox="0 0 1200 240" aria-hidden="true">
          <path class="journey__track" d={d}></path>
          <path class="journey__path" d={d}></path>
          {stops.map((s) => <circle class="journey__pt" cx={s.x} cy={s.y} r="6" />)}
        </svg>
        <ol class="journey__stops">
          {
            stops.map((s) => (
              <li
                class="journey__stop"
                data-side={s.y < 120 ? 'up' : 'down'}
                style={`--x:${((s.x / 1200) * 100).toFixed(2)}%; --y:${((s.y / 240) * 100).toFixed(2)}%`}
              >
                <span class="journey__city">{s.city}</span>
                <span class="journey__year">{s.year}</span>
                <span class="journey__note">{s.note}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="about__today">
      <p class="about__h" data-reveal>Today</p>
      <dl class="roles" data-stagger>
        {
          profile.roles.map((r) => (
            <div class="role">
              <dt>{r.title}</dt>
              <dd>{r.org}</dd>
            </div>
          ))
        }
      </dl>
      <p class="small about__past" data-reveal>
        Earlier: {profile.past.join('; ')}. He writes in Arabic, English and Somali, and teaches also in Norwegian
        and Malay.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(6rem, 13vw, 12rem) clamp(5rem, 10vw, 9rem);
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .about__title {
    grid-column: 1 / 9;
  }

  .about__plate {
    grid-column: 10 / 13;
    grid-row: 1 / 4;
    margin: 0;
  }

  .about__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 3px;
    background: var(--paper-3);
    box-shadow: var(--shadow-plate);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    filter: grayscale(1) contrast(1.06);
    transition: filter 1.4s var(--ease-out);
  }

  .about__plate:hover :global(img) {
    filter: grayscale(0) contrast(1);
  }

  .about__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .about__caption [lang='ar'] {
    font-size: 1.05rem;
    color: var(--ink);
  }

  .about__body {
    grid-column: 1 / 8;
    font-size: 1.08rem;
  }

  .about__mission {
    grid-column: 1 / 9;
    position: relative;
  }

  .about__mission p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.4vw, 2.4rem);
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* ---------- the road ---------- */

  .journey {
    grid-column: 1 / -1;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .journey__label,
  .about__h {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .journey__map {
    position: relative;
    aspect-ratio: 1200 / 240;
    margin: 5.5rem 0 6rem;
  }

  .journey__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .journey__track {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    vector-effect: non-scaling-stroke;
  }

  .journey__path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .journey__pt {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.55);
    opacity: 0.35;
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.7s,
      fill 0.7s,
      stroke 0.7s;
  }

  .journey__pt.is-on {
    transform: scale(1);
    opacity: 1;
    fill: var(--accent);
    stroke: var(--accent);
  }

  .journey__stops {
    position: absolute;
    inset: 0;
  }

  .journey__stop {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    gap: 0.2rem;
    justify-items: center;
    text-align: center;
    opacity: 0.38;
    transition: opacity 0.7s var(--ease-out);
  }

  .journey__stop.is-on {
    opacity: 1;
  }

  .journey__stop[data-side='down'] {
    transform: translate(-50%, 0);
    padding-top: 1.5rem;
  }

  .journey__stop[data-side='up'] {
    transform: translate(-50%, -100%);
    padding-bottom: 1.5rem;
  }

  .journey__city {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  .journey__year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  .journey__note {
    max-width: 13rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  /* ---------- today ---------- */

  .about__today {
    grid-column: 1 / 10;
  }

  .roles {
    display: grid;
    margin-top: 1.5rem;
  }

  .role {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0.5rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .role:last-child {
    border-bottom: 1px solid var(--line);
  }

  .role dt {
    font-weight: 500;
    color: var(--ink);
  }

  .role dd {
    color: var(--ink-3);
  }

  .about__past {
    margin-top: 1.4rem;
    max-width: 60ch;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }

    .about__title,
    .about__body,
    .about__mission,
    .about__today {
      grid-column: 1;
    }

    .about__plate {
      grid-column: 1;
      grid-row: auto;
      position: relative;
      top: 0;
      max-width: 400px;
    }

    .role {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  @media (max-width: 760px) {
    .journey__map {
      aspect-ratio: auto;
      margin: 2rem 0 0;
    }

    .journey__svg {
      display: none;
    }

    .journey__stops {
      position: static;
      display: grid;
      gap: 1.6rem;
      padding-left: 1.4rem;
      border-left: 1px solid var(--line);
    }

    .journey__stop,
    .journey__stop[data-side='up'],
    .journey__stop[data-side='down'] {
      position: static;
      transform: none;
      padding: 0;
      justify-items: start;
      text-align: left;
      opacity: 1;
    }

    .journey__note {
      max-width: none;
    }
  }
</style>
