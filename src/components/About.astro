---
/**
 * The profile, "the parting". Two pages fill the viewport and meet at a
 * hairline: his formation on the left and his posts today on the right, as
 * hairline records set against the seam. Scrolling parts the pages, and
 * standing between them is his portrait, still; his mission arrives whole
 * across the foot of both as they part. Below the pin, the biography on a card of
 * the hero's warmer paper, his gilded name above it. Phones and reduced
 * motion get the same content stacked, without the pin.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/about/portrait-editorial.jpg';
import calligraphy from '../assets/hero/calligraphy-name.png';
import profile from '../data/profile.json';

const formation = profile.timeline.filter((t) => t.year !== 'Today');
const [lead, ...body] = profile.aboutLead;
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container about__head">
    <h2 class="display display--lg" id="about-title" data-split>{profile.aboutHeadline}</h2>
  </div>

  <div class="about__pin">
    <div class="about__stage">
      <figure class="about__between">
        <div class="about__photo">
          <Image
            src={portrait}
            alt="Prof. Dr. Ali Mohamed Salah"
            widths={[320, 520, 800, 1200]}
            sizes="(max-width: 760px) min(18rem, 70vw), (max-width: 900px) min(40vw, 300px), min(26vw, 380px)"
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__caption">
          <span lang="ar">{profile.nameArabic}</span>
          <span>{profile.name}</span>
        </figcaption>
      </figure>

      <div class="about__page about__page--l">
        <div class="about__slot">
          <div class="about__records about__records--l">
            <p class="about__title" aria-hidden="true">{profile.aboutHeadline}</p>
            <dl class="about__rows">
              {
                formation.map((t) => (
                  <div class="about__row">
                    <dt>{t.year}</dt>
                    <dd>
                      <span>{t.title}</span>
                      <span class="about__where">{t.where}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <div class="about__page about__page--r">
        <div class="about__slot">
          <div class="about__records about__records--r">
            <dl class="about__rows">
              {
                profile.roles.map((r) => (
                  <div class="about__row about__row--role">
                    <dt>{r.title}</dt>
                    <dd>{r.org}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="about__past">
              Before Norway he led the Arabic Language Institute at IKIP in Malaysia and lectured at the International
              Islamic University of Malaysia. He writes in Arabic, English and Somali.
            </p>
          </div>
        </div>
      </div>

      <blockquote class="about__mission">
        <p>{profile.mission}</p>
      </blockquote>
    </div>
  </div>

  <div class="container about__bio">
    <div class="about__card" data-reveal data-delay="0.1" style={`--calli: url(${calligraphy.src})`}>
      <span class="about__calli" role="img" aria-label={profile.nameArabic}></span>
      <p class="about__lead">{lead}</p>
      {body.map((p) => <p class="about__body">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: clamp(6rem, 13vw, 12rem);
  }

  .about__head {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .about__head h2 {
    max-width: 22ch;
  }

  .about__photo {
    overflow: hidden;
    border-radius: 3px;
    background: var(--paper-3);
    box-shadow: var(--shadow-plate);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 10%;
  }

  .about__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.8rem;
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .about__caption [lang='ar'] {
    font-size: 1.05rem;
    color: var(--ink);
    text-align: left;
  }

  /* ---------- the records ---------- */

  .about__records {
    display: grid;
    align-content: center;
    gap: 1.5rem;
    height: 100%;
    max-width: 38rem;
  }

  .about__records--l {
    justify-self: end;
  }

  .about__rows {
    display: grid;
  }

  .about__row {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.5rem 1.2rem;
    padding-block: clamp(0.8rem, 1.9vh, 1.3rem);
    border-top: 1px solid var(--line);
  }

  .about__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .about__row--role {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  }

  .about__row dt {
    font-size: 1.05rem;
    color: var(--ink-3);
    padding-top: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .about__row--role dt {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.4vw, 1.4rem);
    font-weight: 500;
    color: var(--ink);
    padding-top: 0;
  }

  .about__row dd {
    display: grid;
    gap: 0.3rem;
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .about__row--role dd {
    font-size: clamp(1.1rem, 1.3vw, 1.3rem);
    color: var(--ink-2);
  }

  .about__where {
    font-size: 1.02rem;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .about__past {
    font-size: 1.06rem;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__mission p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.1vw, 2.1rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* ---------- the biography, framed ---------- */

  .about__bio {
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 10vw, 9rem);
  }

  .about__card {
    max-width: 54rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 5vw, 5rem);
    text-align: center;
    /* White with a fine gold edge (white, black and gold). */
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--gold-line) 55%, transparent);
    border-radius: 22px;
    box-shadow:
      0 1px 2px oklch(19% 0.012 60 / 0.04),
      0 30px 70px -36px oklch(19% 0.012 60 / 0.3);
  }

  .about__calli {
    display: block;
    width: min(11rem, 50%);
    aspect-ratio: 885 / 310;
    margin: 0 auto clamp(1.6rem, 3vw, 2.4rem);
    background-image: linear-gradient(
      112deg,
      var(--gold-3) 0%,
      var(--gold) 30%,
      var(--gold-2) 50%,
      var(--gold) 70%,
      var(--gold-3) 100%
    );
    background-size: 220% 100%;
    -webkit-mask: var(--calli) center / contain no-repeat;
    mask: var(--calli) center / contain no-repeat;
  }

  .about__lead {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }

  .about__body {
    max-width: 40rem;
    margin: clamp(1.2rem, 2vw, 1.7rem) auto 0;
    font-size: 1.02rem;
    line-height: 1.66;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__title {
    display: none;
    margin: 0 0 clamp(0.5rem, 2vh, 1.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 2.9vw, 2.9rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .is-live .about__title {
    display: block;
  }

  .about:has(.about__pin.is-live) .about__head {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- flowing layout (small screens, reduced motion) ---------- */

  .about__pin:not(.is-live) .about__stage {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
  }

  .about__pin:not(.is-live) .about__between {
    margin: 0;
    width: min(18rem, 70vw);
  }

  .about__pin:not(.is-live) .about__photo {
    aspect-ratio: 4 / 5;
  }

  .about__pin:not(.is-live) .about__records {
    height: auto;
    justify-self: start;
  }

  /* ---------- the parting (JS adds .is-live) ---------- */

  .about:has(.about__pin.is-live) {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .about__pin.is-live {
    --rec-top: clamp(0.5rem, 2vh, 1.5rem);
    height: 100svh;
    overflow: hidden;
  }

  .is-live .about__stage {
    position: absolute;
    inset: 0;
  }

  .is-live .about__between {
    position: absolute;
    left: 50%;
    top: 45%;
    width: min(26vw, 380px);
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .is-live .about__photo {
    height: min(56svh, 560px);
  }

  .is-live .about__caption {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  /* The two pages. They cover the portrait, then slide off it (scripts/motion.ts moves them, and
     dims their records, as transforms and opacity). */
  .is-live .about__page {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    padding: calc(var(--nav-h) + 1rem) var(--gutter) 2rem;
    background: var(--paper);
    overflow: hidden;
    display: grid;
    z-index: 2;
  }

  .is-live .about__page--l {
    left: 0;
    border-right: 1px solid var(--line);
  }

  .is-live .about__page--r {
    right: 0;
  }

  /* The records start at the top of the pages, as every section's words start at the top of
     theirs; centred, they left the seam alone above them for a screen's third (2026-11-23). The
     right page's rows start level with the left page's, under its title. */
  .is-live .about__records {
    align-content: start;
    padding-top: var(--rec-top);
  }

  .is-live .about__records--r {
    padding-top: calc(var(--rec-top) + clamp(1.9rem, 2.9vw, 2.9rem) * 1.05 + clamp(0.5rem, 2vh, 1.5rem) + 1.5rem);
  }

  .is-live .about__slot {
    min-height: 0;
  }

  .is-live .about__mission {
    --fade: 0;
    position: absolute;
    left: 50%;
    bottom: 5svh;
    z-index: 3;
    width: min(46rem, 88vw);
    transform: translateX(-50%);
    text-align: center;
    pointer-events: none;
  }

  .is-live .about__mission::before {
    content: '';
    position: absolute;
    inset: -40% -18%;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 50%, var(--paper) 40%, transparent 72%);
    opacity: var(--fade);
  }

  /* The mission arrives whole as the pages part. */
  .is-live .about__mission p {
    opacity: var(--fade);
  }

  @media (max-width: 760px) {
    .about__card {
      border-radius: 16px;
    }
  }

  @media (max-width: 900px) {
    .is-live .about__between {
      width: min(40vw, 300px);
    }
  }
</style>
