---
/* Contact, on one screen: the folio the hero lands on, ruled in gold with corner marks. Who he is
   and where to follow him on the left, the form on the right. The form posts to api/contact.ts,
   which emails it through Resend. Sending traces a red line once round the folio and draws a tick;
   a failure leaves what was written in place and points to the Facebook page instead. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import calligraphy from '../assets/hero/calligraphy-name.png';
import profile from '../data/profile.json';

const facebook = profile.social[0];
const youtube = profile.social[1];
---

<Base
  title="Contact · Prof. Dr. Ali Mohamed Salah"
  description="Invite Prof. Dr. Ali Mohamed Salah to lecture, ask about his books and translations, or write with a question."
>
  <Nav page="inner" current="contact" />
  <main class="contact" style={`--calli: url(${calligraphy.src})`}>
    <article class="folio" id="folio">
      <svg class="folio__rule" aria-hidden="true">
        <rect width="100%" height="100%" pathLength="1"></rect>
        <rect class="folio__trace" width="100%" height="100%" pathLength="1"></rect>
      </svg>
      <i class="corner corner--tl"></i><i class="corner corner--tr"></i><i class="corner corner--bl"></i><i class="corner corner--br"></i>

      <section class="who">
        <div class="calli in" role="img" aria-label={profile.nameArabic} style="--i:0"></div>
        <div class="in" style="--i:1">
          <p class="eyebrow">Contact</p>
          <h1 class="who__title">Lectures, books, <i>or a question.</i></h1>
        </div>
        <p class="who__lede in" style="--i:2">
          Invite Dr. Ali to speak, ask about his books and translations, or write with something on your mind.
        </p>
        <dl class="facts in" style="--i:3">
          <div><dt>Based in</dt><dd>{profile.city}</dd></div>
          <div><dt>Mosque</dt><dd>Tawfiiq Islamic Centre</dd></div>
          <div><dt>Write in</dt><dd>Arabic, English, Somali, Norwegian</dd></div>
          <div><dt>Organisations</dt><dd>Iqra Foundation · Tasanud</dd></div>
        </dl>
        <nav class="follow in" aria-label="Follow" style="--i:4">
          <a href={facebook.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4Z" />
            </svg>
            <b>{facebook.label}</b><span>The official page</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
          <a href={youtube.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z" />
            </svg>
            <b>{youtube.label}</b><span>Lessons on Tawfiiq Duruus</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
          <a href={profile.bookstore} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z" />
            </svg>
            <b>Books</b><span>Amazon author store</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
        </nav>
      </section>

      <section class="write" aria-labelledby="write-h">
        <form class="form" id="contact-form" action="/api/contact" method="post" novalidate>
          <h2 class="form__h in" id="write-h" style="--i:2">Send a message</h2>
          <fieldset class="seg in" style="--i:3">
            <legend class="sr-only">Topic</legend>
            <i class="seg__pill" aria-hidden="true"></i>
            <label><input type="radio" name="topic" value="event" checked /><span>Lecture or event</span></label>
            <label><input type="radio" name="topic" value="books" /><span>Books</span></label>
            <label><input type="radio" name="topic" value="question" /><span>A question</span></label>
            <label><input type="radio" name="topic" value="other" /><span>Other</span></label>
          </fieldset>
          <div class="pair in" style="--i:4">
            <div class="field">
              <input id="c-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="c-name-err" />
              <label for="c-name">Name</label>
              <p class="field__err" id="c-name-err"></p>
            </div>
            <div class="field">
              <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="c-email-err" />
              <label for="c-email">Email</label>
              <p class="field__err" id="c-email-err"></p>
            </div>
          </div>
          <div class="field field--message in" style="--i:5">
            <textarea id="c-message" name="message" required minlength="10" maxlength="5000" aria-describedby="c-message-err"></textarea>
            <label for="c-message">Your message</label>
            <span class="field__count" aria-hidden="true">0 / 5000</span>
            <p class="field__err" id="c-message-err"></p>
          </div>
          <!-- Hidden from people; a bot that fills it in, or sends within seconds of loading, is quietly turned away -->
          <div class="trap" aria-hidden="true">
            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="loadedAt" value="" />
          <div class="form__foot in" style="--i:6">
            <p class="form__note" id="c-note">Your name and email are used only to answer you. <a href="/privacy">Privacy</a></p>
            <button class="btn" type="submit">
              <span class="form__send">Send message</span>
              <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </button>
          </div>
          <p class="form__fail" role="alert" hidden>
            The message could not be sent. Please try again, or write through the official <a href={facebook.url} target="_blank" rel="noopener">Facebook page</a>.
          </p>
        </form>
        <!-- The letter: written from the form, folded in three, put in the envelope and sealed -->
        <div class="post" aria-hidden="true">
          <div class="post__group">
            <div class="env env--back"></div>
            <!-- The top third comes last: it folds over the others, and the browser layers by this order -->
            <div class="sheet">
              <div class="sheet__panel sheet__panel--mid"><div class="sheet__face"></div></div>
              <div class="sheet__panel sheet__panel--bottom"><div class="sheet__face"><i class="shade"></i></div><div class="sheet__back"><i class="shade"></i></div></div>
              <div class="sheet__panel sheet__panel--top">
                <div class="sheet__face"><i class="shade"></i></div>
                <div class="sheet__back">
                  <p class="sheet__to"><span>Prof. Dr. Ali Mohamed Salah</span><small>Oslo</small></p>
                  <i class="shade"></i>
                </div>
              </div>
            </div>
            <div class="env env--front"><i></i></div>
            <div class="env env--flap"><div class="env__hinge"><i></i></div></div>
            <div class="seal"><i class="seal__ring"></i><span lang="ar">ع</span></div>
          </div>
          <!-- The envelope turned over: addressed, stamped, postmarked in Oslo -->
          <div class="cover">
            <p class="cover__from"><small>From</small><span class="cover__sender"></span></p>
            <div class="stamp"><div class="stamp__art"><i></i></div></div>
            <svg class="postmark" viewBox="0 0 220 120">
              <g fill="none" stroke="currentColor">
                <circle cx="160" cy="60" r="44" stroke-width="2.4"></circle>
                <circle cx="160" cy="60" r="35" stroke-width="1.2"></circle>
                <path d="M4 38c14-7 28 7 42 0s28 7 42 0 28 7 42 0M4 60c14-7 28 7 42 0s28 7 42 0 28 7 42 0M4 82c14-7 28 7 42 0s28 7 42 0 28 7 42 0" stroke-width="2.2"></path>
              </g>
              <text x="160" y="47" text-anchor="middle">OSLO</text>
              <text class="postmark__date" x="160" y="66" text-anchor="middle"></text>
              <text x="160" y="83" text-anchor="middle">NORWAY</text>
            </svg>
            <div class="cover__to">
              <i class="cover__rule"></i>
              <p class="cover__name">Prof. Dr. Ali Mohamed Salah</p>
              <p>Tawfiiq Islamic Centre</p>
              <p class="cover__city">Oslo · Norway</p>
            </div>
          </div>
        </div>
        <template id="letter">
          <div class="letter">
            <p class="letter__re"></p>
            <p class="letter__to">Dear Dr. Ali,</p>
            <p class="letter__body"></p>
            <p class="letter__from"></p>
          </div>
        </template>
        <div class="done" tabindex="-1">
          <svg viewBox="0 0 64 48" aria-hidden="true">
            <rect class="done__env" x="4" y="6" width="56" height="36" rx="2" pathLength="1"></rect>
            <path class="done__env" d="M4.5 7 32 28 59.5 7" pathLength="1"></path>
            <circle class="done__seal" cx="32" cy="28" r="5"></circle>
          </svg>
          <p class="done__h">Sent, thank you.</p>
          <p class="done__p">Your message is on its way. Any reply comes to the email you gave.</p>
          <button class="done__again" type="button">Send another</button>
        </div>
      </section>
    </article>
  </main>

  <script>
    import { nav, showNav } from '../scripts/nav';

    nav();
    showNav();

    const folio = document.getElementById('folio')!;
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const pill = form.querySelector<HTMLElement>('.seg__pill')!;
    const count = form.querySelector<HTMLElement>('.field__count')!;
    const fail = form.querySelector<HTMLElement>('.form__fail')!;
    const send = form.querySelector<HTMLElement>('.form__send')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const done = folio.querySelector<HTMLElement>('.done')!;
    const loadedAt = form.elements.namedItem('loadedAt') as HTMLInputElement;
    loadedAt.value = String(Date.now());

    const topics = [...form.querySelectorAll<HTMLInputElement>('[name=topic]')];
    const movePill = () => {
      pill.style.transform = `translateX(${topics.findIndex((r) => r.checked) * 100}%)`;
    };
    topics.forEach((r) => r.addEventListener('change', movePill));

    const fields = [...form.querySelectorAll<HTMLElement>('.field')];
    const control = (f: HTMLElement) => f.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')!;
    const sync = (f: HTMLElement) => f.classList.toggle('has', control(f).value !== '');
    const setError = (f: HTMLElement, text: string) => {
      f.classList.toggle('bad', text !== '');
      control(f).setAttribute('aria-invalid', String(text !== ''));
      f.querySelector('.field__err')!.textContent = text;
    };
    const say = (el: HTMLInputElement | HTMLTextAreaElement) => {
      if (el.validity.valueMissing) return el.name === 'message' ? 'Write a message.' : `Fill in your ${el.name}.`;
      if (el.validity.typeMismatch) return 'This does not look like an email address.';
      if (el.validity.tooShort) return 'Write a little more (at least 10 characters).';
      return '';
    };

    fields.forEach((f) => {
      const el = control(f);
      el.addEventListener('input', () => {
        sync(f);
        if (f.classList.contains('bad')) setError(f, say(el));
        if (el.name === 'message') count.textContent = `${el.value.length} / 5000`;
      });
      sync(f);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      fail.hidden = true;
      const bad = fields.filter((f) => {
        setError(f, say(control(f)));
        return f.classList.contains('bad');
      });
      if (bad.length) {
        control(bad[0]).focus();
        return;
      }

      button.disabled = true;
      send.textContent = 'Sending …';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        post();
      } catch {
        fail.hidden = false;
      } finally {
        button.disabled = false;
        send.textContent = 'Send message';
      }
    });

    /* Once the message is sent: it becomes a letter, folds in three, goes into the envelope, is
       sealed and flies off while the red line runs round the folio; then the thanks. About four
       seconds, once a visit, so it can take its time. With reduced motion, straight to the thanks. */
    const sheet = folio.querySelector<HTMLElement>('.post')!;
    const q = <T extends Element = HTMLElement>(s: string) => sheet.querySelector<T>(s)!;
    const trace = folio.querySelector<SVGRectElement>('.folio__trace')!;
    const template = document.getElementById('letter') as HTMLTemplateElement;
    const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
    const IN_OUT = 'cubic-bezier(0.65, 0, 0.35, 1)';
    let running: Animation[] = [];
    let timers: number[] = [];

    const play = (el: Element, frames: Keyframe[], duration: number, delay: number, easing = EASE_OUT, fill: FillMode = 'both') => {
      running.push(el.animate(frames, { duration, delay, easing, fill }));
    };

    const finish = () => {
      folio.classList.add('is-sent');
      timers.push(window.setTimeout(() => done.focus({ preventScroll: true }), 500));
    };

    function post() {
      const data = new FormData(form);
      const topic = topics.find((r) => r.checked)?.nextElementSibling?.textContent ?? '';
      const write = (letter: HTMLElement) => {
        letter.querySelector('.letter__re')!.textContent = `Re: ${topic}`;
        letter.querySelector('.letter__body')!.textContent = String(data.get('message'));
        letter.querySelector('.letter__from')!.textContent = String(data.get('name'));
        return letter;
      };
      q('.cover__sender').textContent = String(data.get('name'));
      q('.postmark__date').textContent = new Date()
        .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
        .toUpperCase();
      sheet.querySelectorAll('.sheet__face').forEach((face) => {
        face.querySelector('.letter')?.remove();
        face.prepend(write(template.content.firstElementChild!.cloneNode(true) as HTMLElement));
      });

      // The letter takes the room the form had, at a letter's proportions.
      const room = sheet.getBoundingClientRect();
      sheet.style.setProperty('--w', `${Math.min(room.width * 0.8, room.height * 0.68, 480)}px`);
      folio.classList.add('is-posting');

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return finish();

      const [top, bottom] = [q('.sheet__panel--top'), q('.sheet__panel--bottom')];
      const env = [q('.env--back'), q('.env--front'), q('.env--flap')];

      // 1. The form becomes the letter.
      play(q('.sheet'), [{ opacity: 0, transform: 'translateY(10px) scale(0.97)' }, { opacity: 1, transform: 'none' }], 460, 120);

      // 2. Folded in three: the bottom third up, then the top third down, each shading as it turns.
      const fold = (panel: HTMLElement, angle: number, z: number, at: number) => {
        play(panel, [{ transform: 'translateZ(0px) rotateX(0deg)' }, { transform: `translateZ(${z}px) rotateX(${angle}deg)` }], 600, at, IN_OUT);
        play(panel.querySelector('.sheet__face .shade')!, [{ opacity: 0 }, { opacity: 0.32, offset: 0.5 }, { opacity: 0.32 }], 600, at, 'linear');
        play(panel.querySelector('.sheet__back .shade')!, [{ opacity: 0.32 }, { opacity: 0.32, offset: 0.5 }, { opacity: 0 }], 600, at, 'linear');
      };
      fold(bottom, 180, 1, 650);
      fold(top, -180, 2, 1000);

      // 3. The letter lifts, the envelope rises beneath it, and the letter drops into the pocket.
      env.forEach((el) => play(el, [{ opacity: 0, transform: 'translateY(40px)' }, { opacity: 1, transform: 'none' }], 560, 1750));
      play(
        q('.sheet'),
        [
          { opacity: 1, transform: 'none' },
          { opacity: 1, transform: 'translateY(-30%) scale(0.94)', offset: 0.42 },
          { opacity: 1, transform: 'translateY(2%) scale(0.9)' },
        ],
        900,
        1600,
        IN_OUT
      );

      // 4. The flap closes over it, passing in front as it turns down.
      play(q('.env__hinge'), [{ transform: 'perspective(900px) rotateX(180deg)' }, { transform: 'perspective(900px) rotateX(0deg)' }], 560, 2550, IN_OUT);
      play(env[2], [{ zIndex: 0 }, { zIndex: 0, offset: 0.48 }, { zIndex: 4, offset: 0.5 }, { zIndex: 4 }], 560, 2550, 'linear');

      // 5. Sealed in red, the ring of gold going out from it.
      play(q('.seal'), [{ opacity: 0, transform: 'scale(1.5)' }, { opacity: 1, transform: 'scale(0.94)', offset: 0.7 }, { opacity: 1, transform: 'scale(1)' }], 420, 3050);
      play(q('.seal__ring'), [{ opacity: 0.8, transform: 'scale(0.95)' }, { opacity: 0, transform: 'scale(2)' }], 800, 3350);

      // 6. Turned over: the sealed back goes edge-on, and the front comes round, addressed and stamped.
      play(
        q('.post__group'),
        [
          { transform: 'perspective(1400px) rotateY(0deg)', opacity: 1 },
          { transform: 'perspective(1400px) rotateY(90deg)', opacity: 1, offset: 0.99 },
          { transform: 'perspective(1400px) rotateY(90deg)', opacity: 0 },
        ],
        420,
        3700,
        'cubic-bezier(0.55, 0, 0.8, 0.4)'
      );
      play(
        q('.cover'),
        [
          { opacity: 1, transform: 'perspective(1400px) rotateY(-90deg)' },
          { opacity: 1, transform: 'perspective(1400px) rotateY(0deg)' },
        ],
        620,
        4120,
        'cubic-bezier(0.2, 0.6, 0.35, 1)'
      );

      // 7. Postmarked in Oslo, with the little jolt of the stamp coming down.
      play(q('.postmark'), [{ opacity: 0, transform: 'rotate(-14deg) scale(1.35)' }, { opacity: 1, transform: 'rotate(-14deg) scale(1)' }], 200, 4850, 'cubic-bezier(0.5, 0, 0.75, 0)');
      play(q('.cover'), [{ translate: '0 0' }, { translate: '0 3px', offset: 0.3 }, { translate: '0 0' }], 260, 5040, 'ease-out', 'none');

      // 8. The red line runs round the folio as the letter flies off.
      play(trace, [{ opacity: 1, strokeDashoffset: 1 }, { opacity: 1, strokeDashoffset: 0 }], 1600, 5100);
      play(
        q('.cover'),
        [
          { opacity: 1, transform: 'perspective(1400px) translate(0, 0) rotate(0deg) scale(1)' },
          { opacity: 1, transform: 'perspective(1400px) translate(0, -12px) rotate(0deg) scale(1.01)', offset: 0.22 },
          { opacity: 0, transform: 'perspective(1400px) translate(30%, -95%) rotate(-7deg) scale(0.55)' },
        ],
        950,
        5650,
        'cubic-bezier(0.6, 0, 0.3, 1)',
        'forwards'
      );

      timers.push(window.setTimeout(finish, 6250));
    }

    done.querySelector('.done__again')!.addEventListener('click', () => {
      running.forEach((a) => a.cancel());
      timers.forEach(clearTimeout);
      running = [];
      timers = [];
      folio.classList.remove('is-posting');
      form.reset();
      movePill();
      count.textContent = '0 / 5000';
      fields.forEach(sync);
      loadedAt.value = String(Date.now());
      folio.classList.remove('is-sent');
      control(fields[0]).focus();
    });
  </script>
</Base>

<style>
  /* One screen on anything laptop-sized: the folio fills what the bar leaves. */
  .contact {
    --gilt: linear-gradient(100deg, var(--gold-3), var(--gold) 30%, var(--gold-2) 50%, var(--gold) 70%, var(--gold-3));
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--nav-h) + 0.25rem) var(--gutter) clamp(1.25rem, 4vh, 3rem);
    background: var(--paper-2);
  }

  .folio {
    position: relative;
    width: min(100%, 76rem);
    height: calc(100svh - var(--nav-h) - 0.25rem - clamp(1.25rem, 4vh, 3rem));
    max-height: 46rem;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 4.5vw, 4.5rem);
    padding: clamp(1.6rem, 4.2vh, 3rem) clamp(1.6rem, 3.6vw, 3.4rem);
    background: var(--paper);
    box-shadow: var(--shadow-plate);
  }

  .folio__rule {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .folio__rule rect {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.8s var(--ease-out) 0.1s forwards;
  }

  .folio__rule .folio__trace {
    stroke: var(--accent);
    stroke-width: 1.6;
    opacity: 0;
    animation: none;
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--gold);
  }
  .corner--tl { top: 4px; left: 4px; border-top-width: 1px; border-left-width: 1px; }
  .corner--tr { top: 4px; right: 4px; border-top-width: 1px; border-right-width: 1px; }
  .corner--bl { bottom: 4px; left: 4px; border-bottom-width: 1px; border-left-width: 1px; }
  .corner--br { bottom: 4px; right: 4px; border-bottom-width: 1px; border-right-width: 1px; }

  /* ---------- who, where, follow ---------- */

  .who {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    min-height: 0;
  }

  .calli {
    width: min(100%, 17rem);
    aspect-ratio: 885 / 310;
    background: var(--gilt);
    background-size: 200% 100%;
    -webkit-mask: var(--calli) left center / contain no-repeat;
    mask: var(--calli) left center / contain no-repeat;
    animation: rise 0.9s var(--ease-out) both, shine 7s linear infinite;
  }

  .eyebrow {
    margin-top: clamp(0.8rem, 2.2vh, 1.4rem);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .who__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .who__title i {
    font-style: normal;
    font-weight: 300;
    color: var(--ink-3);
  }

  .who__lede {
    margin-top: clamp(0.6rem, 1.6vh, 1rem);
    max-width: 30rem;
    font-size: 0.98rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .facts {
    align-self: center;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.8rem, 2vh, 1.2rem) 1.6rem;
    padding-block: clamp(0.8rem, 2vh, 1.4rem);
    font-size: 0.88rem;
  }

  .facts dt {
    font-size: 0.74rem;
    color: var(--ink-3);
  }

  .facts dd {
    color: var(--ink-2);
  }

  .follow {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .follow a {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.6rem 6.5rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding-block: clamp(0.55rem, 1.4vh, 0.8rem);
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }

  /* a gold wash slides in under the row */
  .follow a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in oklab, var(--gold-2) 30%, transparent), transparent);
    transform: translateX(-101%);
    transition: transform 0.6s var(--ease-out-quint);
  }

  .follow a:hover::before,
  .follow a:focus-visible::before {
    transform: none;
  }

  .follow svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--ink-2);
  }

  .follow b {
    font-weight: 500;
  }

  .follow span {
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .follow .follow__arrow {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.5s var(--ease-out), color 0.4s;
  }

  .follow a:hover .follow__arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  /* ---------- the form ---------- */

  .write {
    position: relative;
    display: grid;
    min-height: 0;
  }

  .form {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: clamp(0.7rem, 1.8vh, 1.05rem);
    min-height: 0;
    transition: opacity 0.5s, transform 0.6s var(--ease-out);
  }

  .form__h {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* The topic: the ink pill slides to the one chosen. */
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: var(--paper-3);
  }

  .seg__pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / 4);
    border-radius: 999px;
    background: var(--ink);
    transition: transform 0.55s var(--ease-out-quint);
  }

  .seg label {
    position: relative;
    text-align: center;
    cursor: pointer;
  }

  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .seg span {
    display: block;
    padding: 0.5rem 0.4rem;
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--ink-2);
    transition: color 0.4s;
  }

  .seg input:checked + span {
    color: var(--paper);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  /* Boxed fields with a notched label that floats up; a gold ring breathes in on focus. */
  .field {
    position: relative;
    display: grid;
    min-height: 0;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.95rem 1rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    outline: 0;
    background: var(--paper);
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    transition: border-color 0.35s, box-shadow 0.5s var(--ease-out);
  }

  .field textarea {
    height: 100%;
    min-height: 6rem;
    padding-top: 1.1rem;
    resize: none;
    line-height: 1.5;
  }

  .field label {
    position: absolute;
    left: 0.75rem;
    top: 0.82rem;
    padding: 0 0.3rem;
    background: var(--paper);
    font-size: 0.95rem;
    color: var(--ink-3);
    pointer-events: none;
    transform-origin: left center;
    transition: transform 0.45s var(--ease-out), color 0.3s;
  }

  .field:focus-within input,
  .field:focus-within textarea {
    border-color: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--gold-2) 35%, transparent);
  }

  .field:focus-within label,
  .field.has label {
    transform: translateY(-1.3rem) scale(0.8);
  }

  .field:focus-within label {
    color: var(--gold-3);
  }

  .field.bad input,
  .field.bad textarea {
    border-color: var(--accent);
  }

  .field.bad label {
    color: var(--accent);
  }

  .field__err {
    font-size: 0.76rem;
    color: var(--accent);
  }

  .field__err:empty {
    display: none;
  }

  .field__count {
    position: absolute;
    right: 0.9rem;
    bottom: 0.55rem;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .field--message:has(.field__err:not(:empty)) .field__count {
    bottom: 1.75rem;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form__note {
    max-width: 18rem;
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .form__note a,
  .form__fail a {
    box-shadow: 0 1px 0 var(--line-strong);
  }

  .form__fail {
    font-size: 0.86rem;
    color: var(--accent);
  }

  .btn {
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .btn:disabled {
    cursor: wait;
    opacity: 0.75;
  }

  /* ---------- sent ---------- */

  .done {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.7rem;
    text-align: center;
    outline: 0;
    opacity: 0;
    visibility: hidden;
  }

  .done svg {
    width: 4.4rem;
    height: 3.3rem;
    overflow: visible;
  }

  .done__env {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .done__seal {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.6);
    opacity: 0;
  }

  .done__h {
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .done__p {
    max-width: 24rem;
    color: var(--ink-2);
  }

  .done__again {
    margin-top: 0.4rem;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink);
    box-shadow: 0 1px 0 currentColor;
  }

  /* Posting: the form gives way to the letter it wrote (choreographed in the script). */
  .is-posting .form {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(-6px) scale(0.985);
    visibility: hidden;
    transition:
      opacity 0.28s,
      filter 0.28s,
      transform 0.4s var(--ease-out),
      visibility 0s 0.4s;
  }

  .is-sent .folio__rule .folio__trace {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .is-sent .done {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s;
  }

  .is-sent .done__env { animation: draw 0.9s var(--ease-out) forwards; }
  .is-sent .done path.done__env { animation-delay: 0.35s; }
  .is-sent .done__seal { animation: seal-dot 0.45s var(--ease-out) 0.85s forwards; }
  .is-sent .done__h,
  .is-sent .done__p,
  .is-sent .done__again { animation: rise 0.7s var(--ease-out) both; }
  .is-sent .done__h { animation-delay: 0.5s; }
  .is-sent .done__p { animation-delay: 0.6s; }
  .is-sent .done__again { animation-delay: 0.7s; }

  @keyframes seal-dot {
    to { opacity: 1; transform: none; }
  }

  /* ---------- the letter and its envelope ---------- */

  /* --w is the letter's width, set from the room the form had; the rest follows from it. */
  .post {
    --h: calc(var(--w) * 1.25);
    --ew: calc(var(--w) * 1.08);
    --eh: calc(var(--w) * 0.66);
    --env: oklch(94.6% 0.016 82);
    --env-light: oklch(96.8% 0.012 84);
    --edge: color-mix(in oklab, var(--gold) 55%, transparent);
    position: absolute;
    inset: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .is-posting .post {
    visibility: visible;
  }

  .post__group {
    position: absolute;
    inset: 0;
  }

  .post__group > * {
    position: absolute;
    left: 50%;
    top: 50%;
    opacity: 0;
  }

  .sheet {
    z-index: 2;
    width: var(--w);
    height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
    perspective: 1600px;
    transform-style: preserve-3d;
  }

  .sheet__panel {
    position: absolute;
    left: 0;
    width: 100%;
    height: calc(var(--h) / 3);
    transform-style: preserve-3d;
  }

  .sheet__panel--top { top: 0; transform-origin: 50% 100%; }
  .sheet__panel--mid { top: calc(var(--h) / 3); }
  .sheet__panel--bottom { top: calc(var(--h) * 2 / 3); transform-origin: 50% 0; }

  .sheet__face,
  .sheet__back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #fffdf8;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .sheet__face {
    box-shadow: 0 1px 2px oklch(19% 0.012 60 / 0.07);
  }

  /* The outside of the paper, which is what shows once it is folded. */
  .sheet__back {
    transform: rotateX(180deg);
    background: oklch(98.2% 0.008 84);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--gold) 28%, transparent);
  }

  /* Addressed on the outside, as a folded letter would be. */
  .sheet__to {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: calc(var(--w) * 0.012);
    text-align: center;
  }

  .sheet__to span {
    font-family: var(--font-arabic);
    font-size: calc(var(--w) * 0.05);
    line-height: 1.1;
    color: var(--ink);
  }

  .sheet__to small {
    font-size: calc(var(--w) * 0.024);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .sheet__to::after {
    content: '';
    order: -1;
    width: calc(var(--w) * 0.08);
    height: 1px;
    margin-bottom: calc(var(--w) * 0.02);
    background: var(--accent);
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(oklch(19% 0.012 60 / 0.5), oklch(19% 0.012 60 / 0.15));
    opacity: 0;
  }

  /* Each third shows its own part of the one letter. */
  .letter {
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--h);
    display: flex;
    flex-direction: column;
    padding: calc(var(--w) * 0.09) calc(var(--w) * 0.1);
    color: var(--ink);
  }

  .letter::before {
    content: '';
    position: absolute;
    inset: calc(var(--w) * 0.03);
    border: 1px solid color-mix(in oklab, var(--gold) 38%, transparent);
    pointer-events: none;
  }

  .sheet__panel--mid .letter { top: calc(var(--h) / -3); }
  .sheet__panel--bottom .letter { top: calc(var(--h) * -2 / 3); }

  .letter__re {
    align-self: flex-end;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .letter__to {
    margin-top: calc(var(--w) * 0.05);
    font-family: var(--font-arabic);
    font-size: calc(var(--w) * 0.058);
    line-height: 1.2;
  }

  /* The message on writing lines, fading out where the page runs short. */
  .letter__body {
    flex: 1;
    min-height: 0;
    margin-top: calc(var(--w) * 0.035);
    overflow: hidden;
    font-size: calc(var(--w) * 0.032);
    line-height: calc(var(--w) * 0.072);
    color: var(--ink-2);
    white-space: pre-line;
    overflow-wrap: anywhere;
    background: linear-gradient(transparent calc(var(--w) * 0.072 - 1px), var(--line) 0) 0 0 / 100% calc(var(--w) * 0.072);
    -webkit-mask: linear-gradient(#000 78%, transparent);
    mask: linear-gradient(#000 78%, transparent);
  }

  .letter__from {
    align-self: flex-end;
    margin-top: calc(var(--w) * 0.03);
    font-family: var(--font-arabic);
    font-size: calc(var(--w) * 0.05);
  }

  .letter__from::before {
    content: '— ';
    color: var(--ink-3);
  }

  .env {
    width: var(--ew);
    height: var(--eh);
    margin: calc(var(--eh) / -2) 0 0 calc(var(--ew) / -2);
  }

  .env--back {
    z-index: 1;
    border-radius: 3px;
    background: linear-gradient(oklch(92.8% 0.018 80), var(--env));
    box-shadow:
      0 1px 2px oklch(19% 0.012 60 / 0.08),
      0 24px 40px -18px oklch(19% 0.012 60 / 0.3);
  }

  /* The pocket: everything but the notch the letter goes in by. A gold hairline runs along its folds. */
  .env--front {
    z-index: 3;
    filter: drop-shadow(0 -1px 0 var(--edge)) drop-shadow(0 -6px 10px oklch(19% 0.012 60 / 0.06));
  }

  .env--front i {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: linear-gradient(to top, var(--env), var(--env-light));
    clip-path: polygon(0 0, 50% 54%, 100% 0, 100% 100%, 0 100%);
  }

  .env--flap {
    z-index: 0;
    height: calc(var(--eh) * 0.58);
    margin-top: calc(var(--eh) / -2);
    filter: drop-shadow(0 1px 0 var(--edge)) drop-shadow(0 8px 10px oklch(19% 0.012 60 / 0.1));
  }

  .env__hinge {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0;
    transform: perspective(900px) rotateX(180deg);
  }

  .env__hinge i {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--env-light), oklch(95.6% 0.014 83));
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  /* The seal sits where the flap's point closes. */
  .seal {
    --s: calc(var(--w) * 0.17);
    z-index: 5;
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--eh) * 0.08 - var(--s) / 2) 0 0 calc(var(--s) / -2);
    border-radius: 48% 52% 50% 50% / 52% 47% 53% 48%;
    background:
      radial-gradient(circle at 50% 50%, transparent 54%, oklch(33% 0.12 28 / 0.55) 56%, transparent 62%),
      radial-gradient(circle at 34% 28%, oklch(60% 0.17 30), var(--accent) 55%, oklch(34% 0.12 26));
    box-shadow:
      0 1px 1px oklch(25% 0.1 28 / 0.5),
      0 4px 10px -2px oklch(25% 0.1 28 / 0.45),
      inset 0 1px 1px oklch(75% 0.12 35 / 0.6);
  }

  .seal span {
    margin-top: -0.18em;
    font-family: var(--font-arabic);
    font-size: calc(var(--s) * 0.7);
    font-weight: 700;
    line-height: 1;
    background: var(--gilt);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 oklch(28% 0.1 28 / 0.6));
  }

  .seal__ring {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1px solid var(--gold-2);
    opacity: 0;
  }

  /* ---------- the envelope turned over ---------- */

  .cover {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 6;
    width: var(--ew);
    height: var(--eh);
    margin: calc(var(--eh) / -2) 0 0 calc(var(--ew) / -2);
    border-radius: 3px;
    background:
      radial-gradient(120% 90% at 30% 20%, oklch(97.4% 0.011 85), transparent 70%),
      linear-gradient(oklch(96% 0.014 84), var(--env));
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--gold) 22%, transparent),
      0 1px 2px oklch(19% 0.012 60 / 0.08),
      0 24px 40px -18px oklch(19% 0.012 60 / 0.3);
    opacity: 0;
  }

  /* A fine gold rule inside the edge, as round the folio. */
  .cover::before {
    content: '';
    position: absolute;
    inset: calc(var(--w) * 0.02);
    border: 1px solid color-mix(in oklab, var(--gold) 40%, transparent);
    border-radius: 2px;
    pointer-events: none;
  }

  .cover__from {
    position: absolute;
    left: 7%;
    top: 10%;
    display: grid;
    gap: calc(var(--w) * 0.006);
  }

  .cover__from small {
    font-size: calc(var(--w) * 0.021);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cover__sender {
    font-family: var(--font-arabic);
    font-size: calc(var(--w) * 0.038);
    color: var(--ink-2);
  }

  /* A postage stamp: perforated paper round his gilded name on madder. */
  .stamp {
    --perf: calc(var(--w) * 0.007);
    position: absolute;
    right: 6%;
    top: 9%;
    width: 25%;
    aspect-ratio: 1.22;
    padding: calc(var(--perf) * 2.4);
    background: #fffdf8;
    filter: drop-shadow(0 1px 1.5px oklch(19% 0.012 60 / 0.25));
    -webkit-mask:
      radial-gradient(var(--perf) at var(--perf) var(--perf), #0000 97%, #000) calc(var(--perf) * -1) calc(var(--perf) * -1) / calc(var(--perf) * 2) calc(var(--perf) * 2),
      linear-gradient(#000 0 0) content-box;
    mask:
      radial-gradient(var(--perf) at var(--perf) var(--perf), #0000 97%, #000) calc(var(--perf) * -1) calc(var(--perf) * -1) / calc(var(--perf) * 2) calc(var(--perf) * 2),
      linear-gradient(#000 0 0) content-box;
    transform: rotate(2deg);
  }

  .stamp__art {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(90% 70% at 50% 35%, oklch(44% 0.13 28), oklch(30% 0.1 26));
    box-shadow:
      inset 0 0 0 calc(var(--w) * 0.006) oklch(30% 0.1 26),
      inset 0 0 0 calc(var(--w) * 0.008) var(--gold);
  }

  .stamp__art i {
    width: 84%;
    aspect-ratio: 885 / 310;
    background: var(--gilt);
    background-size: 200% 100%;
    -webkit-mask: var(--calli) center / contain no-repeat;
    mask: var(--calli) center / contain no-repeat;
  }

  /* Postmark ink: a little uneven, laid over the stamp's corner. */
  .postmark {
    position: absolute;
    right: 16%;
    top: 12%;
    width: 44%;
    color: oklch(30% 0.03 260 / 0.62);
    mix-blend-mode: multiply;
    transform: rotate(-14deg);
    opacity: 0;
    -webkit-mask: radial-gradient(circle at 30% 40%, #000 55%, rgb(0 0 0 / 0.7) 80%);
    mask: radial-gradient(circle at 30% 40%, #000 55%, rgb(0 0 0 / 0.7) 80%);
  }

  .postmark text {
    fill: currentColor;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .postmark .postmark__date {
    font-size: 11.5px;
    letter-spacing: 0.06em;
  }

  .cover__to {
    position: absolute;
    left: 38%;
    top: 52%;
    display: grid;
    gap: calc(var(--w) * 0.008);
    font-size: calc(var(--w) * 0.028);
    color: var(--ink-2);
  }

  .cover__rule {
    width: calc(var(--w) * 0.07);
    height: 1px;
    margin-bottom: calc(var(--w) * 0.012);
    background: var(--accent);
  }

  .cover__name {
    font-family: var(--font-arabic);
    font-size: calc(var(--w) * 0.05);
    line-height: 1.15;
    color: var(--ink);
  }

  .cover__city {
    font-size: calc(var(--w) * 0.022);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .in {
    animation: rise 0.9s var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 70ms + 80ms);
  }

  .calli.in {
    animation-delay: 80ms, 0s;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
