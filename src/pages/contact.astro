---
/* Contact, on one screen: the folio the hero lands on, ruled in gold with corner marks. Who he is
   and where to follow him on the left, the form on the right. The form posts to api/contact.ts,
   which emails it through Resend. Sending traces a red line once round the folio and draws a tick;
   a failure leaves what was written in place and points to the Facebook page instead. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import calligraphy from '../assets/hero/calligraphy-name.png';
import profile from '../data/profile.json';

const facebook = profile.social[0];
const youtube = profile.social[1];
---

<Base
  title="Contact · Prof. Dr. Ali Mohamed Salah"
  description="Invite Prof. Dr. Ali Mohamed Salah to lecture, ask about his books and translations, or write with a question."
>
  <Nav page="inner" current="contact" />
  <main class="contact" style={`--calli: url(${calligraphy.src})`}>
    <article class="folio" id="folio">
      <svg class="folio__rule" aria-hidden="true">
        <rect width="100%" height="100%" pathLength="1"></rect>
        <rect class="folio__trace" width="100%" height="100%" pathLength="1"></rect>
      </svg>
      <i class="corner corner--tl"></i><i class="corner corner--tr"></i><i class="corner corner--bl"></i><i class="corner corner--br"></i>

      <section class="who">
        <div class="calli in" role="img" aria-label={profile.nameArabic} style="--i:0"></div>
        <div class="in" style="--i:1">
          <p class="eyebrow">Contact</p>
          <h1 class="who__title">Lectures, books, <i>or a question.</i></h1>
        </div>
        <p class="who__lede in" style="--i:2">
          Invite Dr. Ali to speak, ask about his books and translations, or write with something on your mind.
        </p>
        <dl class="facts in" style="--i:3">
          <div><dt>Based in</dt><dd>{profile.city}</dd></div>
          <div><dt>Mosque</dt><dd>Tawfiiq Islamic Centre</dd></div>
          <div><dt>Write in</dt><dd>Arabic, English, Somali, Norwegian</dd></div>
          <div><dt>Organisations</dt><dd>Iqra Foundation · Tasanud</dd></div>
        </dl>
        <nav class="follow in" aria-label="Follow" style="--i:4">
          <a href={facebook.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4Z" />
            </svg>
            <b>{facebook.label}</b><span>The official page</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
          <a href={youtube.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z" />
            </svg>
            <b>{youtube.label}</b><span>Lessons on Tawfiiq Duruus</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
          <a href={profile.bookstore} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z" />
            </svg>
            <b>Books</b><span>Amazon author store</span>
            <svg class="follow__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" /></svg>
          </a>
        </nav>
      </section>

      <section class="write" aria-labelledby="write-h">
        <form class="form" id="contact-form" action="/api/contact" method="post" novalidate>
          <h2 class="form__h in" id="write-h" style="--i:2">Send a message</h2>
          <fieldset class="seg in" style="--i:3">
            <legend class="sr-only">Topic</legend>
            <i class="seg__pill" aria-hidden="true"></i>
            <label><input type="radio" name="topic" value="event" checked /><span>Lecture or event</span></label>
            <label><input type="radio" name="topic" value="books" /><span>Books</span></label>
            <label><input type="radio" name="topic" value="question" /><span>A question</span></label>
            <label><input type="radio" name="topic" value="other" /><span>Other</span></label>
          </fieldset>
          <div class="pair in" style="--i:4">
            <div class="field">
              <input id="c-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="c-name-err" />
              <label for="c-name">Name</label>
              <p class="field__err" id="c-name-err"></p>
            </div>
            <div class="field">
              <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="c-email-err" />
              <label for="c-email">Email</label>
              <p class="field__err" id="c-email-err"></p>
            </div>
          </div>
          <div class="field field--message in" style="--i:5">
            <textarea id="c-message" name="message" required minlength="10" maxlength="5000" aria-describedby="c-message-err"></textarea>
            <label for="c-message">Your message</label>
            <span class="field__count" aria-hidden="true">0 / 5000</span>
            <p class="field__err" id="c-message-err"></p>
          </div>
          <!-- Hidden from people; a bot that fills it in, or sends within seconds of loading, is quietly turned away -->
          <div class="trap" aria-hidden="true">
            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="loadedAt" value="" />
          <div class="form__foot in" style="--i:6">
            <p class="form__note" id="c-note">Your name and email are used only to answer you. <a href="/privacy">Privacy</a></p>
            <button class="btn" type="submit">
              <span class="form__send">Send message</span>
              <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </button>
          </div>
          <p class="form__fail" role="alert" hidden>
            The message could not be sent. Please try again, or write through the official <a href={facebook.url} target="_blank" rel="noopener">Facebook page</a>.
          </p>
        </form>
        <div class="done" tabindex="-1">
          <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" pathLength="1"></circle><path d="M20 33l8 8 16-17" pathLength="1"></path></svg>
          <p class="done__h">Sent, thank you.</p>
          <p class="done__p">Your message is on its way. Any reply comes to the email you gave.</p>
          <button class="done__again" type="button">Send another</button>
        </div>
      </section>
    </article>
  </main>

  <script>
    import { nav, showNav } from '../scripts/nav';

    nav();
    showNav();

    const folio = document.getElementById('folio')!;
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const pill = form.querySelector<HTMLElement>('.seg__pill')!;
    const count = form.querySelector<HTMLElement>('.field__count')!;
    const fail = form.querySelector<HTMLElement>('.form__fail')!;
    const send = form.querySelector<HTMLElement>('.form__send')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const done = folio.querySelector<HTMLElement>('.done')!;
    const loadedAt = form.elements.namedItem('loadedAt') as HTMLInputElement;
    loadedAt.value = String(Date.now());

    const topics = [...form.querySelectorAll<HTMLInputElement>('[name=topic]')];
    const movePill = () => {
      pill.style.transform = `translateX(${topics.findIndex((r) => r.checked) * 100}%)`;
    };
    topics.forEach((r) => r.addEventListener('change', movePill));

    const fields = [...form.querySelectorAll<HTMLElement>('.field')];
    const control = (f: HTMLElement) => f.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')!;
    const sync = (f: HTMLElement) => f.classList.toggle('has', control(f).value !== '');
    const setError = (f: HTMLElement, text: string) => {
      f.classList.toggle('bad', text !== '');
      control(f).setAttribute('aria-invalid', String(text !== ''));
      f.querySelector('.field__err')!.textContent = text;
    };
    const say = (el: HTMLInputElement | HTMLTextAreaElement) => {
      if (el.validity.valueMissing) return el.name === 'message' ? 'Write a message.' : `Fill in your ${el.name}.`;
      if (el.validity.typeMismatch) return 'This does not look like an email address.';
      if (el.validity.tooShort) return 'Write a little more (at least 10 characters).';
      return '';
    };

    fields.forEach((f) => {
      const el = control(f);
      el.addEventListener('input', () => {
        sync(f);
        if (f.classList.contains('bad')) setError(f, say(el));
        if (el.name === 'message') count.textContent = `${el.value.length} / 5000`;
      });
      sync(f);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      fail.hidden = true;
      const bad = fields.filter((f) => {
        setError(f, say(control(f)));
        return f.classList.contains('bad');
      });
      if (bad.length) {
        control(bad[0]).focus();
        return;
      }

      button.disabled = true;
      send.textContent = 'Sending …';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        folio.classList.add('is-sent');
        setTimeout(() => done.focus({ preventScroll: true }), 400);
      } catch {
        fail.hidden = false;
      } finally {
        button.disabled = false;
        send.textContent = 'Send message';
      }
    });

    done.querySelector('.done__again')!.addEventListener('click', () => {
      form.reset();
      movePill();
      count.textContent = '0 / 5000';
      fields.forEach(sync);
      loadedAt.value = String(Date.now());
      folio.classList.remove('is-sent');
      control(fields[0]).focus();
    });
  </script>
</Base>

<style>
  /* One screen on anything laptop-sized: the folio fills what the bar leaves. */
  .contact {
    --gilt: linear-gradient(100deg, var(--gold-3), var(--gold) 30%, var(--gold-2) 50%, var(--gold) 70%, var(--gold-3));
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--nav-h) + 0.25rem) var(--gutter) clamp(1.25rem, 4vh, 3rem);
    background: var(--paper-2);
  }

  .folio {
    position: relative;
    width: min(100%, 76rem);
    height: calc(100svh - var(--nav-h) - 0.25rem - clamp(1.25rem, 4vh, 3rem));
    max-height: 46rem;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 4.5vw, 4.5rem);
    padding: clamp(1.6rem, 4.2vh, 3rem) clamp(1.6rem, 3.6vw, 3.4rem);
    background: var(--paper);
    box-shadow: var(--shadow-plate);
  }

  .folio__rule {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .folio__rule rect {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.8s var(--ease-out) 0.1s forwards;
  }

  .folio__rule .folio__trace {
    stroke: var(--accent);
    stroke-width: 1.6;
    opacity: 0;
    animation: none;
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--gold);
  }
  .corner--tl { top: 4px; left: 4px; border-top-width: 1px; border-left-width: 1px; }
  .corner--tr { top: 4px; right: 4px; border-top-width: 1px; border-right-width: 1px; }
  .corner--bl { bottom: 4px; left: 4px; border-bottom-width: 1px; border-left-width: 1px; }
  .corner--br { bottom: 4px; right: 4px; border-bottom-width: 1px; border-right-width: 1px; }

  /* ---------- who, where, follow ---------- */

  .who {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    min-height: 0;
  }

  .calli {
    width: min(100%, 17rem);
    aspect-ratio: 885 / 310;
    background: var(--gilt);
    background-size: 200% 100%;
    -webkit-mask: var(--calli) left center / contain no-repeat;
    mask: var(--calli) left center / contain no-repeat;
    animation: rise 0.9s var(--ease-out) both, shine 7s linear infinite;
  }

  .eyebrow {
    margin-top: clamp(0.8rem, 2.2vh, 1.4rem);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .who__title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .who__title i {
    font-style: normal;
    font-weight: 300;
    color: var(--ink-3);
  }

  .who__lede {
    margin-top: clamp(0.6rem, 1.6vh, 1rem);
    max-width: 30rem;
    font-size: 0.98rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .facts {
    align-self: center;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.8rem, 2vh, 1.2rem) 1.6rem;
    padding-block: clamp(0.8rem, 2vh, 1.4rem);
    font-size: 0.88rem;
  }

  .facts dt {
    font-size: 0.74rem;
    color: var(--ink-3);
  }

  .facts dd {
    color: var(--ink-2);
  }

  .follow {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .follow a {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.6rem 6.5rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding-block: clamp(0.55rem, 1.4vh, 0.8rem);
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }

  /* a gold wash slides in under the row */
  .follow a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in oklab, var(--gold-2) 30%, transparent), transparent);
    transform: translateX(-101%);
    transition: transform 0.6s var(--ease-out-quint);
  }

  .follow a:hover::before,
  .follow a:focus-visible::before {
    transform: none;
  }

  .follow svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--ink-2);
  }

  .follow b {
    font-weight: 500;
  }

  .follow span {
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .follow .follow__arrow {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.5s var(--ease-out), color 0.4s;
  }

  .follow a:hover .follow__arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  /* ---------- the form ---------- */

  .write {
    position: relative;
    display: grid;
    min-height: 0;
  }

  .form {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: clamp(0.7rem, 1.8vh, 1.05rem);
    min-height: 0;
    transition: opacity 0.5s, transform 0.6s var(--ease-out);
  }

  .form__h {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* The topic: the ink pill slides to the one chosen. */
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: var(--paper-3);
  }

  .seg__pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / 4);
    border-radius: 999px;
    background: var(--ink);
    transition: transform 0.55s var(--ease-out-quint);
  }

  .seg label {
    position: relative;
    text-align: center;
    cursor: pointer;
  }

  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .seg span {
    display: block;
    padding: 0.5rem 0.4rem;
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--ink-2);
    transition: color 0.4s;
  }

  .seg input:checked + span {
    color: var(--paper);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  /* Boxed fields with a notched label that floats up; a gold ring breathes in on focus. */
  .field {
    position: relative;
    display: grid;
    min-height: 0;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.95rem 1rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    outline: 0;
    background: var(--paper);
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    transition: border-color 0.35s, box-shadow 0.5s var(--ease-out);
  }

  .field textarea {
    height: 100%;
    min-height: 6rem;
    padding-top: 1.1rem;
    resize: none;
    line-height: 1.5;
  }

  .field label {
    position: absolute;
    left: 0.75rem;
    top: 0.82rem;
    padding: 0 0.3rem;
    background: var(--paper);
    font-size: 0.95rem;
    color: var(--ink-3);
    pointer-events: none;
    transform-origin: left center;
    transition: transform 0.45s var(--ease-out), color 0.3s;
  }

  .field:focus-within input,
  .field:focus-within textarea {
    border-color: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--gold-2) 35%, transparent);
  }

  .field:focus-within label,
  .field.has label {
    transform: translateY(-1.3rem) scale(0.8);
  }

  .field:focus-within label {
    color: var(--gold-3);
  }

  .field.bad input,
  .field.bad textarea {
    border-color: var(--accent);
  }

  .field.bad label {
    color: var(--accent);
  }

  .field__err {
    font-size: 0.76rem;
    color: var(--accent);
  }

  .field__err:empty {
    display: none;
  }

  .field__count {
    position: absolute;
    right: 0.9rem;
    bottom: 0.55rem;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .field--message:has(.field__err:not(:empty)) .field__count {
    bottom: 1.75rem;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form__note {
    max-width: 18rem;
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .form__note a,
  .form__fail a {
    box-shadow: 0 1px 0 var(--line-strong);
  }

  .form__fail {
    font-size: 0.86rem;
    color: var(--accent);
  }

  .btn {
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .btn:disabled {
    cursor: wait;
    opacity: 0.75;
  }

  /* ---------- sent ---------- */

  .done {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.7rem;
    text-align: center;
    outline: 0;
    opacity: 0;
    visibility: hidden;
  }

  .done svg {
    width: 4.2rem;
    height: 4.2rem;
  }

  .done circle,
  .done path {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .done circle {
    stroke: var(--gold);
    stroke-width: 1.2;
  }

  .done path {
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .done__h {
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .done__p {
    max-width: 24rem;
    color: var(--ink-2);
  }

  .done__again {
    margin-top: 0.4rem;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink);
    box-shadow: 0 1px 0 currentColor;
  }

  /* The form lifts away, the red line runs once round the folio, the tick draws itself. */
  .is-sent .form {
    opacity: 0;
    transform: translateY(-12px);
    visibility: hidden;
    transition: opacity 0.5s, transform 0.6s var(--ease-out), visibility 0s 0.6s;
  }

  .is-sent .folio__rule .folio__trace {
    opacity: 1;
    animation: draw 1.6s var(--ease-out) forwards;
  }

  .is-sent .done {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s 0.4s;
  }

  .is-sent .done circle { animation: draw 1s var(--ease-out) 0.5s forwards; }
  .is-sent .done path { animation: draw 0.6s var(--ease-out) 1.2s forwards; }
  .is-sent .done__h,
  .is-sent .done__p,
  .is-sent .done__again { animation: rise 0.7s var(--ease-out) both; }
  .is-sent .done__h { animation-delay: 1.3s; }
