---
/**
 * Each book's own page, /books/<id> (2026-11-23): so every book has an address of its own that
 * search engines can find, index and show. The book stands in its pool of light as on the books
 * page (BookStand.astro, page mode), with its whole description, colophon and Amazon listings, then
 * the other books' covers, each leading to its own page. At night, like the books page.
 *
 * For search: its own title and description, the cover as the shared picture, and schema.org Book
 * and BreadcrumbList data (JSON-LD). The sitemap lists every book page (sitemap.xml.ts).
 */
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BookStand from '../../components/books/BookStand.astro';
import '../../styles/vitrine.css';
import { allBooks, type Book } from '../../lib/books';
import { blurb } from '../../lib/library';
import { vitrine, bookHref } from '../../lib/vitrine';
import profile from '../../data/profile.json';

export async function getStaticPaths() {
  const books = await allBooks();
  return books.map((b) => ({ params: { id: b.id }, props: { id: b.id } }));
}

const { id } = Astro.props as { id: string };
const books = await allBooks();
const { groups, v } = await vitrine(books);
const x = v(id);
const d = x.b.data;

/* What search shows: the title (with its English or Latin name for an Arabic book) and the
   opening of the description, cut at a sentence. */
const other = d.language === 'ar' ? d.titleEn || d.titleLatin : null;
const title = `${d.title}${other ? ` (${other})` : ''} · ${profile.name}`;
/* The opening of the description in the book's own language, carried on through its next
   paragraphs (and its English title) until it says enough, cut at a word near 155 characters. */
const b = blurb(x.b, 30);
const more = [b.text, ...x.all.filter((p) => p.text !== b.text && p.dir === b.dir).map((p) => p.text), d.titleEn ?? '', d.subtitle ?? ''];
let said = '';
for (const t of more) if (said.length < 120 && t && !said.includes(t)) said = said ? `${said} ${t}` : t;
const description = said.length > 158 ? `${said.slice(0, 155).replace(/\s+\S*$/, '')}…` : said;

const cover = await getImage({ src: d.cover, width: 800, format: 'jpg', quality: 82 });
const url = new URL(bookHref(id), Astro.site).href;
const site = new URL('/', Astro.site).href;

/* How he stands to the book: author, translator or editor. */
const person = { '@type': 'Person', name: 'Ali Mohamed Salah', alternateName: profile.name, url: site, sameAs: profile.social.map((s) => s.url) };
const role = d.role.startsWith('Translated') ? 'translator' : d.role.startsWith('Critical') ? 'editor' : 'author';
const book = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: d.title,
  ...(d.titleLatin || d.titleEn ? { alternateName: [d.titleLatin, d.titleEn].filter(Boolean) } : {}),
  ...(d.subtitle ? { alternativeHeadline: d.subtitle } : {}),
  [role]: person,
  inLanguage: d.language,
  isbn: d.ean,
  numberOfPages: d.pages,
  bookFormat: 'https://schema.org/Paperback',
  ...(d.publisher ? { publisher: { '@type': 'Organization', name: d.publisher } } : {}),
  ...(d.year ? { datePublished: String(d.year) } : {}),
  image: new URL(cover.src, Astro.site).href,
  description: b.text,
  url,
  sameAs: d.amazon.map((a) => a.url),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Books', item: new URL('/books', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
const others = groups.map((g) => ({ ...g, books: g.books.filter((o: Book) => o.id !== id) }));
---

<Base theme="#0c0b09" title={title} description={description} image={cover.src} imageAlt={`The cover of ${d.title}`} type="book">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(book)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <script is:inline>
    /* At night, as the books page is; decided before the bar paints. */
    document.documentElement.classList.add('books-night');
  </script>
  <Nav page="inner" current="books" />
  <main class="vt vt--page">
    <BookStand x={x} page />
    <section class="vt__more" aria-labelledby="vt-more">
      <h2 id="vt-more">More books</h2>
      <div class="vt__covers">
        {
          others.map((g) => (
            <div class="vt__cg" role="group" aria-label={g.name}>
              {g.books.map((o: Book) => (
                <a class="vt__cv" href={bookHref(o.id)} aria-label={o.data.title}>
                  <Image src={o.data.cover} alt="" widths={[120, 200]} sizes="84px" loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          ))
        }
      </div>
      <p class="vt__back"><a class="link" href="/books">The whole library</a></p>
    </section>
  </main>
  <Footer page="inner" />
  <script>
    import '../../scripts/smooth';
    import { nav, showNav } from '../../scripts/nav';
    import { reveals } from '../../scripts/reveals';

    nav();
    showNav();
    reveals();
  </script>
</Base>
