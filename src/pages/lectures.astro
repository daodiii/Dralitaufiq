---
/* The lectures: "the reading room" (components/LecturesRoom.astro). The home page's table of stacks
   leads here with "All the lectures". */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LecturesRoom from '../components/LecturesRoom.astro';
---

<Base theme="#0c0b09"
  title="Lectures · Prof. Dr. Ali Mohamed Salah"
  description="Every lesson of Prof. Dr. Ali Mohamed Salah on YouTube, series by series: the whole Qur'an explained, Riyāḍ aṣ-Ṣāliḥīn, the lives of the Prophet and his Companions, Bulūgh al-Marām, Ḥiṣn al-Muslim, and his talks in English and Somali."
>
  <script is:inline>
    /* The lectures are at night: decided before the bar paints, so it reads light from the start. */
    document.documentElement.classList.add('lectures-night');
  </script>
  <Nav page="inner" current="lectures" />
  <main>
    <LecturesRoom />
  </main>
  <Footer page="inner" />
  <script>
    import '../scripts/smooth';
  </script>
</Base>
