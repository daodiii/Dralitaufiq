---
/* The books: the vitrine at night (BooksVitrine.astro, scripts/books/vitrine.ts), and on a phone the
   pile (scripts/books/pile.ts).
   The home page's shelf and fan link here, to one book with ?book=<id>. A phone gets the pile
   however it is held (html.phone, Base.astro), and so does any window narrower than 760px, the
   home page's split. Decided once, before the first paint, so a phone never flashes the vitrine. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BooksVitrine from '../components/books/BooksVitrine.astro';
import Pile from '../components/books/Pile.astro';
import BookSheet from '../components/books/BookSheet.astro';
import { allBooks } from '../lib/books';

const books = await allBooks();
---

<Base title="Books · Prof. Dr. Ali Mohamed Salah" description="The books of Prof. Dr. Ali Mohamed Salah in Arabic, English and Somali.">
  <script is:inline>
    /* A window that reports no width yet (an embedded browser opening hidden) is not a phone. */
    /* A link to one book opens on it: the pile shows it as the page is read (Pile.astro), the vitrine
       is brought to it before the first paint (below). The vitrine is at night (books-night), so the
       bar reads light from the start. */
    var book = new URLSearchParams(location.search).get('book');
    if (book) document.documentElement.dataset.book = book;
    if ((window.innerWidth > 0 && !window.matchMedia('(min-width: 760px)').matches) || document.documentElement.classList.contains('phone')) {
      document.documentElement.classList.add('books-pile');
    } else document.documentElement.classList.add('books-night');
  </script>
  <Nav page="inner" />
  <main>
    <BooksVitrine books={books} />
    <script is:inline>
      /* ?book=<id> opens on that book: brought into view as soon as it is in the page, before the
         first paint, so the shelf never flashes first. */
      (function () {
        var h = document.documentElement;
        var el = h.dataset.book && !h.classList.contains('books-pile') && document.getElementById('bk-' + h.dataset.book);
        if (!el) return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        el.scrollIntoView({ block: 'start' });
      })();
    </script>
    <Pile books={books} />
  </main>
  <Footer page="inner" />
  <BookSheet books={books} />
  <script>
    import '../scripts/smooth';

    if (document.documentElement.classList.contains('books-pile')) import('../scripts/books/pile');
    else import('../scripts/books/vitrine');
  </script>
</Base>
