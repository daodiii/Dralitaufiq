---
/* The books: the reading room (BooksRoom.astro, scripts/books/room.ts), and on a phone the pile
   (scripts/books/pile.ts).
   The home page's shelf and fan link here, to one book with ?book=<id>. A phone gets the pile
   however it is held (html.phone, Base.astro), and so does any window narrower than 760px, the
   home page's split. Decided once, before the first paint, so a phone never flashes the room. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BooksRoom from '../components/books/BooksRoom.astro';
import Pile from '../components/books/Pile.astro';
import BookSheet from '../components/books/BookSheet.astro';
import { allBooks } from '../lib/books';

const books = await allBooks();
---

<Base title="Books · Prof. Dr. Ali Mohamed Salah" description="The books of Prof. Dr. Ali Mohamed Salah in Arabic, English and Somali.">
  <script is:inline>
    /* A window that reports no width yet (an embedded browser opening hidden) is not a phone. */
    /* A link to one book opens on it: the pile shows it as the page is read (Pile.astro), the room
       opens it (BooksRoom.astro). */
    var book = new URLSearchParams(location.search).get('book');
    if (book) document.documentElement.dataset.book = book;
    if ((window.innerWidth > 0 && !window.matchMedia('(min-width: 760px)').matches) || document.documentElement.classList.contains('phone')) {
      document.documentElement.classList.add('books-pile');
    }
  </script>
  <Nav page="inner" />
  <main>
    <h1 class="sr-only">The library</h1>
    <BooksRoom books={books} />
    <Pile books={books} />
  </main>
  <Footer page="inner" />
  <BookSheet books={books} />
  <script>
    import '../scripts/smooth';

    if (document.documentElement.classList.contains('books-pile')) import('../scripts/books/pile');
    else import('../scripts/books/room');
  </script>
</Base>
