---
import '@fontsource-variable/geist/wght.css';
import '@fontsource/amiri/400.css';
import '@fontsource/amiri/700.css';
import '../styles/global.css';
import Consent from '../components/Consent.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /* The colour of the phone's browser bar: the black of the night pages, or the white. */
  theme?: string;
  /* The picture a shared link shows (a path or a full URL), and what the page is (og:type). */
  image?: string;
  imageAlt?: string;
  type?: string;
}

const { title, description, noindex = false, theme = '#fbfaf7', image, imageAlt, type = 'website' } = Astro.props;
const ogImage = new URL(image ?? '/og.jpg', Astro.site);
/* Pages are built as files (astro.config.mjs); their one address has no .html and no slash. */
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/', Astro.site);

/* The viewport never scales below 1 (zooming in still works). Otherwise a touch device zooms out
   to fit anything that sticks out past the screen, even for the instant the pins are measured,
   and innerHeight then reads the zoomed-out height: on a touch tablet every pin came out long.

   html.phone marks a phone however it is held (a touch screen whose short side is under 600px;
   tablets start at 744). The touch test keeps a computer with a mouse out, even in an embedded
   browser that reports a tiny screen while it opens. Held sideways it is wider than the 760px split, and still gets the phone's parts:
   the fan, the lectures' screen, the books page's pile. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Prof. Dr. Ali Mohamed Salah" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt ?? 'Prof. Dr. Ali Mohamed Salah, scholar, author and translator'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(pointer: coarse)').matches && Math.min(screen.width, screen.height) < 600)
        document.documentElement.classList.add('phone');
    </script>
  </head>
  <body>
    <slot />
    <Consent />
  </body>
</html>
